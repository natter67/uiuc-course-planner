:3,"genEd":["1CLL"],"degreeAttributes":"Advanced Composition course.","scheduleNote":"","info":"Same as GWS 392 and SOC 392. Prerequisite: Any 100, 200, or 300-level LLS, GWS, or SOC course.","linkedByLetter":false,"sections":[{"crn":"50108","code":"A","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["R"],"start":600,"end":740,"location":"119 English Building","instructors":["Corona Valencia, G"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"LLS 396","subject":"LLS","number":"396","title":"Adv Topics Latina/o Studies","creditHours":"2 OR 3 hours","minHours":2,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"May be repeated in the same or separate terms to a maximum of 6 hours.","linkedByLetter":false,"sections":[{"crn":"54982","code":"EG","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["R"],"start":930,"end":1070,"location":"103 1207 W Oregon","instructors":["Guzman, E"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"\"Visualizing Borderlands\": Over the past two decades, more than seventy border walls have been constructed worldwide in the name of sovereignty and security. These physical barriers are accompanied by legal regimes that restrict mobility, intensify surveillance, and reinforce “us versus them” nationalisms. This course examines how borders are built, enforced, inhabited, and contested, with particular attention to Latin American and U.S. Latino contexts. We will analyze how borders are represented, visualized, maintained, and contested in media, art, and literature. We will investigate not only geopolitical borders, but also linguistic, racial, gendered, and embodied boundaries that shape Latinidad and diaspora. Drawing from scholarship, literature, film, photography, and sound, students will explore how artists, activists, and communities represent, navigate, and reimagine borderlands as sites of struggle, creativity, and belonging."}]},{"id":"LLS 412","subject":"LLS","number":"412","title":"Social Work with Latine","creditHours":"3 OR 4 hours","minHours":3,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Same as SOCW 412. See SOCW 412.","linkedByLetter":false,"sections":[{"crn":"51941","code":"A","typeCode":"ONL","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Online","typeCode":"ONL","days":["W"],"start":1080,"end":1170,"location":"n.a.","instructors":["Ramirez, X"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"LLS 433","subject":"LLS","number":"433","title":"Foundations of Bilingual Education","creditHours":"4 hours","minHours":4,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Same as CI 433. See CI 433.","linkedByLetter":false,"sections":[{"crn":"35731","code":"A","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M"],"start":960,"end":1130,"location":"37 Education Building","instructors":["Wawire, P"]}],"restrictions":["Restricted to Undergrad - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"LLS 479","subject":"LLS","number":"479","title":"Race, Medicine, and Society","creditHours":"3 OR 4 hours","minHours":3,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Same as AAS 479 and ANTH 479. 3 undergraduate hours. 4 graduate hours. Prerequisite: LLS 100 or consent of instructor.","linkedByLetter":false,"sections":[{"crn":"55871","code":"G","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"