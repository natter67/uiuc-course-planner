[{"id":"FR 101","subject":"FR","number":"101","title":"Elementary French I","creditHours":"4 hours","minHours":4,"genEd":[],"degreeAttributes":"","scheduleNote":"All students in this course will be required to do language laboratory work outside of class.","info":"","linkedByLetter":false,"sections":[{"crn":"37429","code":"B","typeCode":"ONL","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Online","typeCode":"ONL","days":["M","T","W","R"],"start":540,"end":590,"location":"n.a.","instructors":["Clay, A","Wikle, J"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"37431","code":"D","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M","T","W","R"],"start":660,"end":710,"location":"325 Gregory Hall","instructors":["Clay, A","McDowell, S"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"37434","code":"D1","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M","T","W","R"],"start":720,"end":770,"location":"1120 Literatures, Cultures, & Ling","instructors":["Clay, A","Norris, N"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"37432","code":"E","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M","T","W","R"],"start":780,"end":830,"location":"325 Gregory Hall","instructors":["Bequette, Z","Clay, A"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"37433","code":"F","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture