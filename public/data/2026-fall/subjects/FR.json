ame":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":570,"end":650,"location":"1060 Wymer Hall","instructors":["Clay, A"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"FR 211","subject":"FR","number":"211","title":"Introduction to Literary Studies","creditHours":"3 hours","minHours":3,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Prerequisite: FR 207 or equivalent.","linkedByLetter":false,"sections":[{"crn":"67090","code":"A","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M","W"],"start":840,"end":920,"location":"1134 Literatures, Cultures, & Ling","instructors":["Mall, L"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"\"Online synchronous, weekly meetings on Zoom.”"}]},{"id":"FR 212","subject":"FR","number":"212","title":"Introduction to Cultural Analysis: French Identities","creditHours":"3 hours","minHours":3,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Prerequisite: FR 207.","linkedByLetter":false,"sections":[{"crn":"67076","code":"A","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":660,"end":740,"location":"1040 Literatures, Cultures, & Ling","instructors":["Gaillard, J"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"77335","code":"AA","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":540,"end":620,"location":"1120 Literatures, Cultures, & Ling","instructors":["Gaillard, J"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"FR 215","subject":"FR","number":"215","title":"French in the Community","creditHours":"3 hours","minHours":3,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Class requires a service-learning component in addition to the regular class times. Students must arrange 20 hours of service learning outside of the classroom over the semester in coordination with the instructor. May be repeated in separate semesters up to 6 hours. Prerequisite: FR 204, or four years of high school French.","linkedByLetter":false,"sections":[{"crn":"80782","code":"AM","typeCode":"LEC","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture","typeCode":"LEC","days":["T","R"],"start":600,"end":650,"location":"1040 Literatures, Cultures, & Ling","instructors":["Mroz, A"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"Here's a description: Study of the various cultures, practices, perspectives, and influences of French, starting with French in the Americas and zooming in onto French in our local community of Urbana-Champaign — past, present, and future. This theoretical exploration is complemented with 20 hours of mandatory, guided, in-field experiential learning in our community (e.g., Le Cercle Francophone, the Center for Refugees, Reading Across America, French Dual-Immersion programs in Yankee Ridge or Stratton Academy). This course can be taken as a 200-level course or as a 300-level course with an Independent Study add-on. Pre-requisite: 207 or 314 + 205 or 313 + 211 or 212."}]},{"id":"FR 240","subject":"FR","number":"240","title":"Constr Afr and Carib Identity","creditHours":"3 hours","minHours":3,"genEd":["1NW","1LA"],"degreeAttributes":"Humanities - Lit & Arts, and Cultural Studies - Non-West course.","scheduleNote":"","info":"Credit is not given towards the major or minor in French. Same as AFST 209, CWL 225, and LAST 240.","linkedByLetter":false,"sections":[{"crn":"43240","code":"D","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":930,"end":1010,"location":"317 Gregory Hall","instructors":["Reynolds, F"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"FR 240 introduces students to literature and film that address the complexities of postcolonial identity in French-speaking Caribbean and Africa. The course begins with foundational theory and moves through literature and cinema, concluding with diaspora, examined through film as key sites for representing migration, displacement, and transnational identity. FR 240 is reading-intensive and conducted in English."}]},{"id":"FR 301","subject":"FR","number":"301","title":"Medieval and Early Modern Literature","creditHours":"3 hours","minHours":3,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Prerequisite: FR 211 and FR 212.","linkedByLetter":false,"sections":[{"crn":"81368","code":"A","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":930,"end":1010,"location":"1032 Literatures, Cultures, & Ling","instructors":["Keller, M"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"FR 319","subject":"FR","number":"319","title":"Francophone Worlds","creditHours":"3 hours","minHours":3,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Same as CWL 317. May be repeated to a maximum of 6 hours if topics vary. Prerequisite: FR 207, FR 211, and FR 212; or equivalents.","linkedByLetter":false,"sections":[{"crn":"77334","code":"A","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":750,"end":830,"location":"G58 Literatures, Cultures, & Ling","instructors":["Proulx, F"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"This course proposes an introduction to French-language literature and cinema from Quebec, from the 1960s to the present. Students will hone their reading, writing, and analytical skills through the exploration of short stories, novels, plays, poems, and films. We will examine questions of language, representation and identity; history and social change; First Nations peoples and their voices in contemporary film and literature; and modern Quebec’s relationship to its English-speaking neighbors and to France."}]},{"id":"FR 322","subject":"FR","number":"322","title":"Movements and Perspectives","creditHours":"3 hours","minHours":3,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"May be repeated to a maximum of 6 hours. Prerequisite: FR 207, FR 211, and FR 212; or equivalents.","linkedByLetter":false,"sections":[{"crn":"43806","code":"A","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M","W"],"start":960,"end":1040,"location":"Location Pending","instructors":["Mall, L"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"Les Années noires (1940-1944) and their aftermath in film, literature, memoirs and documents such as photography. We’ll explore the following: the Vichy regime ; everyday life in Paris during the Nazi Occupation ; collaboration and resistance ; the Holocaust ; the interplay between history and memory. Online synchronous, weekly meetings on Zoom."}]},{"id":"FR 385","subject":"FR","number":"385","title":"Politics of the European Union","creditHours":"3 hours","minHours":3,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Same as EURO 385, GER 385, and PS 385. See PS 385.","linkedByLetter":false,"sections":[{"crn":"44148","code":"A","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M","W"],"start":810,"end":890,"location":"206 David Kinley Hall","instructors":["Kourtikakis, K"]}],"restrictions":["Not intended for students with Freshman class standing."],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"FR 390","subject":"FR","number":"390","title":"Indiv Study Major Tutorial","creditHours":"1 TO 12 hours","minHours":1,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Approved for Letter and S/U grading. May be repeated to a maximum of 12 hours. Prerequisite: FR 205, FR 207, or equivalent; a declared major in French; junior standing.","linkedByLetter":false,"sections":[{"crn":"81115","code":"APM","typeCode":"IND","group":"ind","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Independent Study","typeCode":"IND","days":[],"start":null,"end":null,"location":"Location Pending","instructors":["Mroz, A"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"49803","code":"MK","typeCode":"IND","group":"ind","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Independent Study","typeCode":"IND","days":[],"start":null,"end":null,"location":"Location Pending","instructors":["Keller, M"]}],"restrictions":[],"coRequest":null,"specialApproval":"Departmental Approval Required","sectionText":null}]},{"id":"FR 460","subject":"FR","number":"460","title":"Principles of Language Testing","creditHours":"3 OR 4 hours","minHours":3,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Same as EIL 460, EPSY 487, GER 460, ITAL 460, PORT 460, and SPAN 460. See EIL 460.","linkedByLetter":false,"sections":[{"crn":"33695","code":"G4","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":780,"end":860,"location":"G7 Literatures, Cultures, & Ling","instructors":["Zhang, Q"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":"Restricted to graduate students only."},{"crn":"33433","code":"U3","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":780,"end":860,"location":"G7 Literatures, Cultures, & Ling","instructors":["Zhang, Q"]}],"restrictions":["Restricted to Undergrad - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":"Restricted to undergraduate students only."}]},{"id":"FR 481","subject":"FR","number":"481","title":"Theoretical Foundations of SLA","creditHours":"3 OR 4 hours","minHours":3,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Same as GER 489, ITAL 489, LING 489, PORT 489, and SPAN 489. See LING 489.","linkedByLetter":false,"sections":[{"crn":"33655","code":"G4","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M","W","F"],"start":600,"end":650,"location":"G20 Literatures, Cultures, & Ling","instructors":["Mendoza, A"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":"Restricted to graduate students only."},{"crn":"33454","code":"U3","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M","W","F"],"start":600,"end":650,"location":"G20 Literatures, Cultures, & Ling","instructors":["Mendoza, A"]}],"restrictions":["Restricted to Undergrad - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":"Restricted to undergraduate students only."}]},{"id":"FR 492","subject":"FR","number":"492","title":"Senior Thesis","creditHours":"2 hours","minHours":2,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"3 undergraduate hours. No graduate credit. May be repeated to a maximum of 4 hours. Prerequisite: Senior standing.","linkedByLetter":false,"sections":[{"crn":"10138","code":"","typeCode":"IND","group":"ind","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Independent Study","typeCode":"IND","days":[],"start":null,"end":null,"location":"Location Pending","instructors":[]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"FR 505","subject":"FR","number":"505","title":"Teaching College and Secondary Foreign Language","creditHours":"4 hours","minHours":4,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Same as ITAL 505.","linkedByLetter":false,"sections":[{"crn":"29911","code":"B","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M"],"start":900,"end":1070,"location":"Location Pending","instructors":["Clay, A"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"Periodic required pedagogical workshops will be organized throughout the semester. This course will be held in the French & Italian library, room 2142 LCLB"}]},{"id":"FR 576","subject":"FR","number":"576","title":"Seminar in Francophonie","creditHours":"4 hours","minHours":4,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"May be repeated in separate terms if topics vary.","linkedByLetter":false,"sections":[{"crn":"72800","code":"A","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["W"],"start":900,"end":1010,"location":"ARR Literatures, Cultures, & Ling","instructors":["Keller, M"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"Postcolonial Memory in Contemporary Belgian Literature: With the independence of Congo in 1960 ended Belgium’s colonization and exploitation of Central Africa that lasted three quarters of a century. The colonial experience constitutes a major chapter in modern Belgian history and left an indelible mark on the young state’s collective memory. We will explore the major shifts in postcolonial memory that have occurred since the early 2000s in Belgian literature on both sides of the linguistic divide and examine if and how the Belgian treatment of the colonial experience differs from that in French, Dutch, and other literatures. Texts by François Emmanuel, Amélie Nothomb, In Koli Jean Bofane, Marie-Louise Mumbu, David van Reybrouck, and Gaea Schoeters among others. Primary and most secondary readings in French. Class discussion in French. Location: LCLB 2142 (FRIT Library)"}]},{"id":"FR 578","subject":"FR","number":"578","title":"Seminar 20thC French Lit","creditHours":"4 hours","minHours":4,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Same as CWL 578. May be repeated.","linkedByLetter":false,"sections":[{"crn":"51279","code":"FP","typeCode":"LEC","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture","typeCode":"LEC","days":["T"],"start":900,"end":1010,"location":"Location Pending","instructors":["Proulx, F"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"FR 578 - Seminar on Marcel Proust's multivolume novel A la recherche du temps perdu (In Search of Lost Time, 1913-1927). Readings include excerpts from each volume of the novel and related critical texts from approaches including genetic criticism, Jewish and queer studies, philosophy, art history, musicology, and cognitive theory. Taught in French; seminar discussions will be conducted in French or English; students from graduate programs other than French Studies are welcome to read the novel in English."}]},