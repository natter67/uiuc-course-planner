":"","linkedByLetter":false,"sections":[{"crn":"49499","code":"E","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":660,"end":740,"location":"124 Burrill Hall","instructors":["Reynolds, F"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"This course will focus on the role of Paris in French culture through literature, art, and film. We will consider the city of Paris from its earliest beginnings to the modern era, as a physical, social, and symbolic reality. Through literature, art, and film we will explore the ways in which Paris is at the center of French political and intellectual life. Additionally, close attention will be paid to historical and political developments and their representation. All readings are in English and the course is conducted in English. Satisfies University General Education Requirement for Western Cultures (Cultural Studies)."}]},{"id":"FR 199","subject":"FR","number":"199","title":"Undergraduate Open Seminar","creditHours":"1 TO 5 hours","minHours":1,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"May be repeated.","linkedByLetter":false,"sections":[{"crn":"10135","code":"","typeCode":"IND","group":"ind","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Independent Study","typeCode":"IND","days":[],"start":null,"end":null,"location":"Location Pending","instructors":[]}],"restrictions":[],"coRequest":null,"specialApproval":"Instructor Approval Required","sectionText":null},{"crn":"65026","code":"ALC","typeCode":"IND","group":"ind","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Independent Study","typeCode":"IND","days":[],"start":null,"end":null,"location":"Location Pending","instructors":["Clay, A"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}