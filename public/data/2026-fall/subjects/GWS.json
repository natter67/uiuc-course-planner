e":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["W"],"start":840,"end":1010,"location":"102 1205 W Nevada","instructors":["Somerville, S"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"For consent, please contact Tasha Robles at tmatos@illinois.edu"}]},{"id":"GWS 580","subject":"GWS","number":"580","title":"Queer Theories & Methods","creditHours":"4 hours","minHours":4,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Prerequisite: Graduate standing.","linkedByLetter":false,"sections":[{"crn":"79545","code":"GM","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T"],"start":660,"end":830,"location":"102 1205 W Nevada","instructors":["Moussawi, G"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"GWS 590","subject":"GWS","number":"590","title":"Topics in GWS","creditHours":"4 hours","minHours":4,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"May be repeated. Prerequisite: Graduate standing and previous coursework in women's or gender studies, or consent of instructor.","linkedByLetter":false,"sections":[{"crn":"48057","code":"KC","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["W"],"start":840,"end":1010,"location":"109A Davenport Hall","instructors":["Clancy, K"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"Meets with ANTH 515, Section KC, CRN: 43688 This course is a bridge between science and technology studies, anthropology, and scientific methodologies typically associated with STEM. We ask broadly what historical and cultural forces produced science as it stands today. But we also specifically ask: how have masculinity contests, toxic workplaces, unjustified hierarchies, and colonizing values around individualism and discovery led to the production of, frankly, crappy science? Using theory as an entry point into a number of methodological and empirical debates, we will think about what it will take to produce feminist science."}]}]