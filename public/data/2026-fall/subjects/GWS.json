subject":"GWS","number":"363","title":"Gender, Health & Pop Culture","creditHours":"3 hours","minHours":3,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"","linkedByLetter":false,"sections":[{"crn":"57509","code":"CN","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":840,"end":920,"location":"133 1207 W Oregon","instructors":["Nadeau, C"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"GWS 370","subject":"GWS","number":"370","title":"Queer Theory","creditHours":"3 hours","minHours":3,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Same as SOC 320. Prerequisite: GWS 100, GWS 201, GWS 202, or consent of instructor.","linkedByLetter":false,"sections":[{"crn":"42909","code":"A","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":750,"end":830,"location":"W115 Turner Hall","instructors":["Nadeau, C"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"GWS 376","subject":"GWS","number":"376","title":"Children and Youth Literature","creditHours":"3 hours","minHours":3,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Same as CWL 376, EURO 376, and SCAN 376. See SCAN 376.","linkedByLetter":false,"sections":[{"crn":"66776","code":"U","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":840,"end":920,"location":"115 English Building","instructors":["Horsfall, W"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"GWS 378","subject":"GWS","number":"378","title":"Fairy Tales & Gender Formation","creditHours":"3 hours","minHours":3,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Same as ENGL 378.","linkedByLetter":false,"sections":[{"crn":"61294","code":"Q","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M","W"],"start":780,"end":860,"location":"110 Speech & Hearing Science Bldg","instructors":["Velez, E"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"Discusses how femininity and gender formation are related through fairy tales. As children grow they are taught the difference between male and female roles. One of the main ways this instruction takes place is through the pleasurable media of fairy tales in books, poems, and more recently, films. Sleeping Beauty, Snow White, Beauty and the Beast, and The Little Mermaid, among others, will be examined to understand how sexual identity is constructed differently in different cultures, and how issues such as rape and incest are addressed within the narratives. The readings explore the ways that fairy tales work to express psychological reactions to maturation while conditioning both characters and readers to adopt specific social roles in adulthood. Meets w/ENGL 378, Sec. S (CRN 61295, Sec. S)"}]},{"id":"GWS 392","subject":"GWS","number":"392","title":"Chicanas&Latinas: Self&Society","creditHours":"3 hours","minHours":3,"genEd":["1CLL"],"degreeAttributes":"Advanced Composition course.","scheduleNote":"","info":"Same as LLS 392 and SOC 392. See LLS 392.","linkedByLetter":false,"sections":[{"crn":"50123","code":"A","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["R"],"start":600,"end":740,"location":"119 English Building","instructors":["Corona Valencia, G"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"GWS 409","subject":