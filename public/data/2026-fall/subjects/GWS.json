coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"80374","code":"AD3","typeCode":"DIS","group":"discussion","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Discussion/Recitation","typeCode":"DIS","days":["R"],"start":900,"end":950,"location":"331 Gregory Hall","instructors":["Pei, A","Williams, C"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"80371","code":"AL1","typeCode":"LEC","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture","typeCode":"LEC","days":["M","W"],"start":900,"end":950,"location":"302 Architecture Building","instructors":["Williams, C"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"GWS 235","subject":"GWS","number":"235","title":"Race and the Politics of Reproduction","creditHours":"3 hours","minHours":3,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Same as LLS 235. See LLS 235.","linkedByLetter":false,"sections":[{"crn":"72007","code":"A","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M","W"],"start":660,"end":740,"location":"103 1207 W Oregon","instructors":["Lira, N"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"GWS 270","subject":"GWS","number":"270","title":"Sexuality and Literature","creditHours":"3 hours","minHours":3,"genEd":["1LA"],"degreeAttributes":"Humanities - Lit & Arts course.","scheduleNote":"","info":"Same as GER 270 and CWL 272. See CWL 272.","linkedByLetter":false,"sections":[{"crn":"55949","code":"DIS","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":780,"end":860,"location":"1024 Literatures, Cultures, & Ling","instructors":["Niekerk, C"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"Topic: Sexuality and Literature: Examination of the historical contexts in which sexuality has been debated during the past three centuries, and to what extent sexuality is perceived differently in diverse cultures. Part one will look at the Western tradition, especially Germany and France. Part two will shift focus to the non-Western world, especially to the colonial history of Indonesia. Same as CWL 272 and GER 270 This course satisfies the General Education Criteria for a Literature and the Arts course. Instructor website: http://www.germanic.illinois.edu/people/niekerk"}]},{"id":"GWS 282","subject":"GWS","number":"282","title":"Feminist and Queer Activisms","creditHours":"3 hours","minHours":3,"genEd":["1US"],"degreeAttributes":"Cultural Studies - US Minority course.","scheduleNote":"","info":"Same as AAS 282 and LLS 282.","linkedByLetter":false,"sections":[{"crn":"81226","code":"TCB","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":570,"end":650,"location":"106B1 Engineering Hall","instructors":["Beauchamp, T"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"GWS 295","subject":"GWS","number":"295","title":"Beginning Topics GWS","creditHours":"3 hours","minHours":3,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Approved for letter and S/U grading. May be repeated in the same term to a maximum of 9 hours; may be repeated in separate terms to a maximum of 12 hours.","linkedByLetter":false,"sections":[{"crn":"55679","code":"CW","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M","W"],"start":660,"end":740,"location":"310 David Kinley Hall","instructors":["Williams, C"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"What is labor? What is the relationship between racism, sexism, and labor exploitation? Why are certain kinds of work assigned to certain kinds of bodies? In this course, we will examine scholarly and activist debates—especially from Ethnic Studies, Black Studies, and Women’s Studies intellectual traditions—about what constitutes work and how certain kinds of work are distributed across race and gender. Although we will focus primarily on unwaged and underpaid work, we will also discuss various forms of paid work and explore demands made by workers to transform their lives, such as higher compensation, comprehensive benefits, and freedom from sexual harassment. We will also explore how workers have organized and creatively resisted to transform the meaning and organization of work. By considering different modes of protest—strikes, work stoppages, and quitting; popular writing; music; and social media—we will interrogate the diverse, hidden, and surprising ways that workers across the globe have shifted the definition of work and staged resistance to labor exploitation."}]},{"id":"GWS 317","subject":"GWS","number":"317","title":"Gender and Human Rights","creditHours":"3 hours","minHours":3,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Prerequisite: GWS 100, GWS 201, or GWS 202 are highly recommended.","linkedByLetter":false,"sections":[{"crn":"79542","code":"MKH","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M","W"],"start":660,"end":740,"location":"125 David Kinley Hall","instructors":["Khan, M"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"Day1Access course materials cost $21.59 and $25.20. For more information see https://go.illinois.edu/Day1Access."}]},{"id":"GWS 325","subject":"GWS","number":"32