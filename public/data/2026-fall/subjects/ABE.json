atusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture","typeCode":"LEC","days":["T","R"],"start":930,"end":1010,"location":"272 Agricultural Engr Sciences Bld","instructors":["Zhang, Y"]}],"restrictions":["Restricted to Undergrad - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":"Undergrad section - 3 credit hours"},{"crn":"81245","code":"B","typeCode":"LEC","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture","typeCode":"LEC","days":["T","R"],"start":930,"end":1010,"location":"272 Agricultural Engr Sciences Bld","instructors":["Zhang, Y"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":"Graduate section - 4 credit hours"},{"crn":"10840","code":"RBH","typeCode":"LAB","group":"lab","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Laboratory","typeCode":"LAB","days":["R"],"start":600,"end":710,"location":"248 Agricultural Engr Sciences Bld","instructors":["Shajahan, S"]},{"typeName":"Lecture","typeCode":"LEC","days":["M","W"],"start":840,"end":890,"location":"248 Agricultural Engr Sciences Bld","instructors":["Shajahan, S"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"Title: Precision Agriculture Engineering Precision Agriculture Engineering explores engineering principles in modern farming, focusing on GPS, GIS, soil sampling, yield monitoring, UAV sensing, and variable-rate technologies. Students learn geospatial analysis using Google Earth Engine and Python for agricultural applications. Course Requirements: Prior experience with Python programming language. Students that have any other programming language experience and have the capacity and interest to pick up new language are welcome."},{"crn":"72232","code":"XW1","typeCode":"ONL","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Online","typeCode":"ONL","days":[],"start":null,"end":null,"location":"n.a.","instructors":["Stillwell, A","Wang, X"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"Students will work as an interdisciplinary team to design a net-zero solar smart-home for the DoE Race to Zero design competition and Solar Decathlon 2023, including an innovative architectural design; efficient HVAC system; photovoltaic power generation; high-efficiency water systems; smart lighting, appliances and home automation; and construction and financial planning. Students will work directly with industry partners and participate in DoE green building training."}]},{"id":"ABE 501","subject":"ABE","number":"501","title":"Graduate Seminar: Foundations of Success","creditHours":"1 hours","minHours":1,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Prerequisite: Restricted to ABE or ETMAS programs.","linkedByLetter":false,"sections":[{"crn":"39806","code":"A","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["F"],"start":720,"end":770,"location":"208 Agricultural Engr Sciences Bld","instructors":["Zhang, Y"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"ABE 503","subject":"ABE","number":"503","title":"Graduate Seminar: Integrity, Teaching and Research","creditHours":"1 hours","minHours":1,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Prerequisite: Restricted to ABE or ETMAS programs.","linkedByLetter":false,"sections":[{"crn":"80363","code":"AE1","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["R"],"start":720,"end":770,"location":"208 Agricultural Engr Sciences Bld","instructors":["Rausch, K"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"ABE 597","subject":"ABE","number":"597","title":"Independent Study","creditHours":"1 TO 4 hours","minHours":1,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"May be repeated to a maximum of 16 hours. Prerequisite: Consent of instructor.","linkedByLetter":false,"sections":[{"crn":"10174","code":"","typeCode":"IND","group":"ind","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Independent Study","typeCode":"IND","days":[],"start":null,"end":null,"location":"Location Pending","instructors":[]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"ABE 598","subject":"ABE","number":"598","title":"Special Topics","creditHours":"1 TO 4 hours","minHours":1,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"May be repeated in the same or separate terms if topics vary to a maximum of 8 hours.","linkedByLetter":false,"sections":[{"crn":"80954","code":"DAG","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":570,"end":645,"location":"2406 Siebel Center for Comp Sci","instructors":["Reid, J"]}],"restrictions":["Not intended for First Time Freshman students.","Restricted to Graduate - Urbana-Champaign.","Restricted to Engineering.","Restricted to MS: Agr & Biol Engr -UIUC or PHD: Agr & Biol Engr -UIUC."],"coRequest":null,"specialApproval":null,"sectionText":"Title: Digital Agriculture <br/> This course explores the digital transformation of agricultural production systems through the integration of automation, AI, sensing, connectivity, and electrification. With rising global challenges related to labor, sustainability, and food security, agriculture is rapidly becoming one of the most complex and impactful domains for cyber-physical systems research and deployment. The course focuses on the engineering foundations of modern farm operations—including field robotics, machine perception, farm management information systems, and digital twins—while emphasizing system integration, safety, and usability in real-world agricultural environments. <br/> Students will read and critique state-of-the-art research papers spanning autonomous machinery, edge/cloud computing for farms, computer vision for crops and livestock, and scalable decision support systems. A semester-long team project will allow students to conceptualize, prototype, and present a solution to a real-world digital agriculture challenge. The course features guest lectures from practicing engineers and stakeholders in the ag tech industry to bring practical perspectives into the classroom. <br/> Prerequisites: Graduate-level in ABE or an engineering discipline"},{"crn":"81319","code":"DAO","typeCode":"OLC","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Online Lecture","typeCode":"OLC","days":["T","R"],"start":570,"end":645,"location":"n.a.","instructors":["Reid, J"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":null}]}]