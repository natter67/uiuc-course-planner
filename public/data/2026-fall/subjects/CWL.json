"113 David Kinley Hall","instructors":["Horsfall, W","Paul, C"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"71789","code":"AD6","typeCode":"DIS","group":"discussion","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Discussion/Recitation","typeCode":"DIS","days":["F"],"start":840,"end":890,"location":"113 David Kinley Hall","instructors":["Horsfall, W","Paul, C"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"58534","code":"AL1","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":750,"end":800,"location":"149 National Soybean Res Ctr","instructors":["Horsfall, W"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"CWL 253","subject":"CWL","number":"253","title":"Medieval Literature and Culture","creditHours":"3 hours","minHours":3,"genEd":["1LA","1WCC"],"degreeAttributes":"Humanities - Lit & Arts, and Cultural Studies - Western course.","scheduleNote":"","info":"Same as ENGL 202 and MDVL 201. See ENGL 202.","linkedByLetter":false,"sections":[{"crn":"33891","code":"D","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M","W","F"],"start":840,"end":890,"location":"131 English Building","instructors":["Newton, K"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"CWL 254","subject":"CWL","number":"254","title":"Grimm's Fairy Tales in Context","creditHours":"3 hours","minHours":3,"genEd":["1WCC","1LA"],"degreeAttributes":"Humanities - Lit & Arts, and Cultural Studies - Western course.","scheduleNote":"","info":"Same as ENGL 266 and GER 251. See GER 251.","linkedByLetter":true,"sections":[{"crn":"61893","code":"AD1","typeCode":"DIS","group":"discussion","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Discussion/Recitation","typeCode":"DIS","days":["F"],"start":720,"end":770,"location":"1022 Lincoln Hall","instructors":["Jenkins, R","Madye, M"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"61894","code":"AD2","typeCode":"DIS","group":"discussion","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Discussion/Recitation","typeCode":"DIS","days":["F"],"start":780,"end":830,"location":"1022 Lincoln Hall","instructors":["Jenkins, R","Madye, M"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"61895","code":"AD3","typeCode":"DIS","group":"discussion","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Discussion/Recitation","typeCode":"DIS","days":["F"],"start":840,"end":890,"location":"1022 Lincoln Hall","instructors":["Jenkins, R"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"61898","code":"AD6","typeCode":"DIS","group":"discussion","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Discussion/Recitation","typeCode":"DIS","days":["F"],"start":660,"end":710,"location":"329 Gregory Hall","instructors":["Jenkins, R","Madye, M"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"Special attention is paid to the Grimms' tales in terms of traditional narrative genres, elements of life in early modern Europe, and versions from Italy and France as well as Germany. Course is conducted in English. Same as GER 251 and ENGL 266. Credit is not given for both CWL 254 and CWL 250."},{"crn":"61868","code":"AL1","typeCode":"LEC","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture","typeCode":"LEC","days":["M","W"],"start":720,"end":770,"location":"160 English Building","instructors":["Jenkins, R"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"Get ready to experience tales you thought you knew and tales you never knew. We read substantial parts of the Grimms' 19th-century collections and some of their French and Italian predecessors, and we consider other storytelling forms, film, and illustration. All the while, we investigate how power, gender, race, class, and ecological issues play out in these surprisingly dense, meaningful, and very old stories. Why do we continue to tell and to know these tales? Why do certain stories recur again and again, in Western and other cultures? The power of narrative is at the center of our lives, and of these tales, and by the end of the semester we will understand this power much better. This course fulfills General Education requirements in Literature and the Arts and in Western and Comparative Culture. Same as GER 251 and ENGL 266. Credit is not given for both CWL 254 and CWL 250."}]},{"id":"CWL 255","subject":"CWL","number":"255","title":"Renaissance Literature and Culture","creditHours":"3 hours","minHours":3,"genEd":["1LA","1WCC"],"degreeAttributes":"Humanities - Lit & Arts, and Cultural Studies - Western course.","scheduleNote":"","info":"Same as ENGL 204. See ENGL 204.","linkedByLetter":false,"sections":[{"crn":"33894","code":"X","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M","W","F"],"start":720,"end":770,"location":"1066 Lincoln Hall","instructors":["Newcomb, L"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"ENGL 204 / CWL 255 - Lori Newcomb - Renaissance Literature and Culture - In this course we read an array of wonderful texts from various European languages, as they emerged from a cultural movement that has been called the “Renaissance.” This period of cultural reinvention, centered in Italy from the 13th through 16th centuries, sought to recover classical learning and artistry that had seemed lost with the fall of the Roman empire. What began as a movement of hope—can cultural riches be given a second life? – ultimately grounded a broad claim for European accomplishment in a great age of “Renaissance men.” This course engages amazing endeavor, while also questioning past idealizations of the Renaissance within broader views of global culture. We’ll read characteristic texts of the period originally written in Italian, French, and Spanish (all in English translation), then conclude by looking at the later and distinct works of the English Renaissance (16th-17th centuries). We’ll focus on readings and works of visual art that give complex pleasure, foreground the era’s ideals (and sometimes shortfalls), and offer insights for our current conditions. The course has four major graded assignments: two short papers and two tests (primarily made up of essay questions). The largest component of the course is your participation in class discussion, emulating the Renaissance ideal of a community of letters."}]},{"id":"CWL 257","subject":"CWL","number":"257","title":"Enlightenment Literature and Culture","creditHours":"3 hours","minHours":3,"genEd":["1LA","1WCC"],"degreeAttributes":"Humanities - Lit & Arts, and Cultural Studies - Western course.","scheduleNote":"","info":"Same as ENGL 206. See ENGL 206.","linkedByLetter":false,"sections":[{"crn":"39525","code":"X","typeCode":"ONL","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Online","typeCode":"ONL","days":["M","W","F"],"start":540,"end":590,"location":"n.a.","instructors":["Nazar, H"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"FA26 ENGL / CWL 206 - Hina Nazar - Have you ever wondered what people mean when they say that the United States is a child of the Enlightenment, or that the Enlightenment is under attack by nativist forces, or that we need to return to Enlightenment values? This course enables you to engage such statements knowledgeably by providing a broad-based introduction to the Enlightenment, a multifaceted cultural and intellectual development of the seventeenth and eighteenth centuries (roughly the period 1650-1800). While many of you are probably familiar with key texts and figures of the American Enlightenment, this course focuses on the European—and, more particularly, the British—Enlightenment, which preceded the founding of the United States. In the seventeenth and eighteenth centuries, Europe witnessed unprecedented social, economic, political, and cultural changes that collectively produced a giant leap toward the world we inhabit today. It was an Age of Revolution and of newfound faith in the rights of the individual though these rights were by no means extended to all. It was an Age of Reason, of tremendous advances in science and technology, though reason was by no means the only altar at which so-called enlightened individuals worshipped: God and sentiment remained powerful forces throughout the long eighteenth century. We will consider how the modern mindset that is associated with the Enlightenment was developed by some of the most significant texts of the period, and how it challenged traditional understandings of duty and humanity’s place in the world. Our readings are divided into four modules. After an overview of the Enlightenment spirit in Module 1, we will dig deeper into such crucial concerns of the period as property, race, and empire (Module 2); morality or virtue (Module 3); and education (Module 4). Gender figures prominently in all four modules since women were finding a public voice and entering the literary marketplace in unprecedented numbers at this time. As the moment in history that is credited with creating the modern world, the Enlightenment continues to speak to us today—as is evidenced by its continued currency in public discourse—and our aim this semester is not only to understand its core values but also to link them with our own."}]},{"id":"CWL 259","subject":"CWL","number":"259","title":"Early African American Literature and Culture","creditHours":"3 hours","minHours":3,"genEd":["1US"],"degreeAttributes":"Cultural Studies - US Minority course.","scheduleNote":"","info":"Same as AFRO 259 and ENGL 259. See ENGL 259.","linkedByLetter":false,"sections":[{"crn":"55610","code":"E","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":570,"end":645,"location":"310 David Kinley Hall","instructors":["Freeburg, C"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"CWL 272","subject":"CWL","number":"272","title":"Sexuality and Literature","creditHours":"3 hours","minHours":3,"genEd":["1LA"],"degreeAttributes":"Humanities - Lit & Arts course.","scheduleNote":"","info":"Same as GER 270 and GWS 270. See GER 270.","linkedByLetter":false,"sections":[{"crn":"55948","code":"DIS","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":780,"end":860,"location":"1024 Literatures, Cultures, & Ling","instructors":["Niekerk, C"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"Topic: Sexuality and LIterature. Examination of the historical contexts in which sexuality has been debated during the past three centuries, and to what extent sexuality is perceived differently in diverse cultures. Part one will look at the Western tradition, especially Germany and France. Part two will shift focus to the non-Western world, especially to the colonial history of Indonesia. Same as GER 270 and GWS 270 This course satisfies the General Education Criteria for a Literature and the Arts course. Instructor webpage: http://www.germanic.illinois.edu/people/niekerk"}]},{"id":"CWL 275","subject":"CWL","number":"275","title":"Masterpieces of East Asian Lit","creditHours":"3 hours","minHours":3,"genEd":["1LA","1NW"],"degreeAttributes":"Humanities - Lit & Arts, and Cultural Studies - Non-West course.","scheduleNote":"","info":"No knowledge of Chinese or Japanese language required. Same as CWL 275.","linkedByLetter":true,"sections":[{"crn":"47198","code":"AD1","typeCode":"DIS","group":"discussion","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Discussion/Recitation","typeCode":"DIS","days":["F"],"start":540,"end":590,"location":"G46 Literatures, Cultures, & Ling","instructors":["Arkenstone, Q","Zhang, Y"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"47200","code":"AD2","typeCode":"DIS","group":"discussion","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Discussion/Recitation","typeCode":"DIS","days":["F"],"start":600,"end":650,"location":"1038 Literatures, Cultures, & Ling","instructors":["Arkenstone, Q","Zhang, Y"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"47202","code":"AD3","typeCode":"DIS","group":"discussion","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Discussion/Recitation","typeCode":"DIS","days":["F"],"start":780,"end":830,"location":"223 David Kinley Hall","instructors":["Arkenstone, Q","Zhang, Y"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"47210","code":"AL1","typeCode":"LEC","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture","typeCode":"LEC","days":["M","W"],"start":720,"end":770,"location":"161 Noyes Laboratory","instructors":["Arkenstone, Q"]}],"restrictions":[],"coRequest":null,"specialA