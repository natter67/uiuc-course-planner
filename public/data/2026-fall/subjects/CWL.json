ode":"A","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["W"],"start":900,"end":1040,"location":"G96 Literatures, Cultures, & Ling","instructors":["Phillips, P"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"73863","code":"E","typeCode":"ONL","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Online","typeCode":"ONL","days":["W"],"start":900,"end":1040,"location":"n.a.","instructors":["Phillips, P"]}],"restrictions":["Restricted to MA:Trnsl & Intrp Online - UIUC."],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"CWL 576","subject":"CWL","number":"576","title":"Methods in Slavic Grad Study","creditHours":"4 hours","minHours":4,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Same as SLAV 576. See SLAV 576.","linkedByLetter":false,"sections":[{"crn":"47732","code":"A","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M"],"start":720,"end":830,"location":"ARR Literatures, Cultures, & Ling","instructors":["Gasyna, G"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"CWL 578","subject":"CWL","number":"578","title":"Seminar 20thC French Lit","creditHours":"4 hours","minHours":4,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Same as FR 578. See FR 578.","linkedByLetter":false,"sections":[{"crn":"37697","code":"FP","typeCode":"LEC","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture","typeCode":"LEC","days":["T"],"start":900,"end":1010,"location":"Location Pending","instructors":[]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"FR 578 - Seminar on Marcel Proust's multivolume novel A la recherche du temps perdu (In Search of Lost Time, 1913-1927). Readings include excerpts from each volume of the novel and related critical texts from approaches including genetic criticism, Jewish and queer studies, philosophy, art history, musicology, and cognitive theory. Taught in French; seminar discussions will be conducted in French or English; students from graduate programs other than French Studies are welcome to read the novel in English."}]},{"id":"CWL 593","subject":"CWL","number":"593","title":"Special Studies","creditHours":"1 TO 4 hours","minHours":1,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"","linkedByLetter":false,"sections":[{"crn":"10460","code":"","typeCode":"IND","group":"ind","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Independent Study","typeCode":"IND","days":[],"start":null,"end":null,"location":"Location Pending","instructors":[]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]}]