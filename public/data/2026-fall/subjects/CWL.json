:660,"end":740,"location":"162 Noyes Laboratory","instructors":["Chiarantini, L","Stoppino, E"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"The Foul and the Fragrant This course will provide an introduction to the medieval and early renaissance literature of Italy from the point of view of education: we will explore topics such as the formation of manners, the creation of ideals of civility, the representation of chivalric behaviors. We will focus on the education of the perfect poet, the perfect wife and the perfect nun; on the upbringing of the perfect lady and the perfect courtier, the care and grooming of the courtly body, and the rejection of the lower bodily functions. In English."}]},{"id":"CWL 241","subject":"CWL","number":"241","title":"Early Masterpieces of Western Culture","creditHours":"3 hours","minHours":3,"genEd":["1WCC","1CLL","1LA"],"degreeAttributes":"Advanced Composition, Humanities - Lit & Arts, and Cultural Studies - Western course.","scheduleNote":"Students must register for one discussion and one lecture section.","info":"Prerequisite: Completion of campus Composition I general education requirement.","linkedByLetter":true,"sections":[{"crn":"40493","code":"ADA","typeCode":"DIS","group":"discussion","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Discussion/Recitation","typeCode":"DIS","days":["F"],"start":540,"end":590,"location":"G48 Literatures, Cultures, & Ling","instructors":["Ibrahim, I"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"40495","code":"ADB","typeCode":"DIS","group":"discussion","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Discussion/Recitation","typeCode":"DIS","days":["F"],"start":600,"end":650,"location":"G48 Literatures, Cultures, & Ling","instructors":["Ibrahim, I"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"40496",