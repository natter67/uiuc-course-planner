inkedByLetter":false,"sections":[{"crn":"40052","code":"1","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M","W","F"],"start":780,"end":830,"location":"104 English Building","instructors":["Karipek, Y"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"SOC 161","subject":"SOC","number":"161","title":"Introduction to Poverty","creditHours":"3 hours","minHours":3,"genEd":["1SS","1WCC"],"degreeAttributes":"Social & Beh Sci - Soc Sci, and Cultural Studies - Western course.","scheduleNote":"","info":"","linkedByLetter":false,"sections":[{"crn":"70117","code":"BD","typeCode":"LEC","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture","typeCode":"LEC","days":["T","R"],"start":840,"end":920,"location":"215 Gregory Hall","instructors":["Dill, B"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"SOC 196","subject":"SOC","number":"196","title":"Issues in Sociology","creditHours":"3 hours","minHours":3,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"May be repeated as topics vary.","linkedByLetter":false,"sections":[{"crn":"32734","code":"IR","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":660,"end":740,"location":"331 Armory","instructors":["Redstone, I"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"Topic: Troglodytes and the \"Wrong Side of History\": The Politics and Morality of Progress This course examines how the idea of “progress” lacks intrinsic meaning, yet exerts powerful moral and political influence by shaping judgments about what counts as improvement or decline. We will analyze how competing values and moral frameworks give content to claims about progress, and how these claims are used to legitimize political positions and cast others as “backward.” The course emphasizes critical analysis of moral reasoning, political discourse, and institutional ideas of social change."},{"crn":"45437","code":"KW","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M","W","F"],"start":660,"end":710,"location":"108 Bevier Hall","instructors":["Wilkins, K"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"Topic: Sociology of Indigenous Peoples and Native Nations What does it mean to be indigenous? How do sociologists study indigeneity and nationhood? What does it mean to do \"Indigenous Sociology\"? In this course we explore these questions as we learn about Indigenous Peoples through a sociological lens. Topics covered include (but are not limited to), indigenous sovereignty and nationhood, settler colonialism, racialization of Indigenous Peoples, national and global social problems Indigenous Peoples face, and intersectional experiences of indigeneity. While this course primarily focuses on Indigenous Peoples in the United States (i.e., American Indians, Alaska Natives, and Native Hawaiians) the perspectives and experiences of other Indigenous Peoples (e.g., Indigenous Peoples of Canada, New Zealand, and Australia) are also included."}]},{"id":"SOC 199","subject":"SOC","number":"199","title":"Undergraduate Open Seminar","creditHours":"1 TO 5 hours","minHours":1,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Approved for both letter and S/U grading. May be repeated.","linkedByLetter":false,"sections":[{"crn":"69587","code":"ADV","typeCode":"LEC","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture","typeCode":"LEC","days":["M"],"start":900,"end":950,"location":"3057 Lincoln Hall","instructors":["Smith, M"]}],"restrictions":["Restricted to Sociology major(s) or minor(s)."],"coRequest":null,"specialApproval":null,"sectionText":"Career development and planning course for sociology majors. Teaches career-development theories; examines the competencies gained from the major; identifies marketable skills; and educates about campus resources for internship/job/career/grad school searches. Students will leave the course with a better understanding of the career decision-making process; the internship/job/grad school search process; and prepared to design their Illini experience for success."}]},{"id":"SOC 200","subject":"SOC","number":"200","title":"Introduction to Sociological Theory","creditHours":"3 hours","minHours":3,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Prerequisite: Sophomore standing.","linkedByLetter":false,"sections":[{"crn":"31132","code":"1","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M","W","F"],"start":600,"end":650,"location":"108 Bevier Hall","instructors":["Wilkins, K"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"Some seats in this course are reserved for Sociology Majors/minors, with the remainder open. Students are recommended to take SOC 100 before enrolling in this course."}]},{"id":"SOC 201","subject":"SOC","number":"201","title":"Race, Gender & Power","creditHours":"3 hours","minHours":3,"genEd":["1WCC"],"degreeAttributes":"Cultural Studies - Western course.","scheduleNote":"","info":"Same as GWS 201. See GWS 201.","linkedByLetter":false,"sections":[{"crn":"60455","code":"A","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":660,"end":740,"location":"1010 Wymer Hall","instructors":["Barnes, T"]}],"restrictions"