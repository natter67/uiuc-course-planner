ng major(s).","Restricted to Graduate - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"CHBE 593","subject":"CHBE","number":"593","title":"Individual Study","creditHours":"0 TO 4 hours","minHours":0,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Approved for both letter and S/U grading. Prerequisite: Consent of the staff member under whom the study is to be made.","linkedByLetter":false,"sections":[{"crn":"10484","code":"","typeCode":"IND","group":"ind","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Independent Study","typeCode":"IND","days":[],"start":null,"end":null,"location":"Location Pending","instructors":[]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"CHBE 594","subject":"CHBE","number":"594","title":"Special Topics","creditHours":"1 TO 4 hours","minHours":1,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"May be repeated. Prerequisite: Consent of instructor.","linkedByLetter":false,"sections":[{"crn":"40683","code":"BAH","typeCode":"L3","group":"l3","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture","typeCode":"L3","days":["M","W","F"],"start":540,"end":590,"location":"1002 Lincoln Hall","instructors":["Harley, B"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":"Meets with CHBE 475 Tissue Engineering"},{"crn":"71538","code":"HJK","typeCode":"L3","group":"l3","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture","typeCode":"L3","days":["T","R"],"start":660,"end":740,"location":"157 Noyes Laboratory","instructors":["Kong, H"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":"Biotransport. Investigates the critical roles the transports of mass, energy and momentum play in the function of living systems at varied levels (e.g., cells , tissues, and organs) and time scales. Transport phenomena are also central to the design and operation of devices for biological research, imaging, biochemical processes, and therapeutic interventions including drug delivery, gene therapy and tissue engineering. Students will explore conservation laws of mass, energy, and momentum to mathematically describe cell and molecular biology, immunology, physiology and biomedical engineering systems. Meets with CHBE 476, Section HJK."},{"crn":"31570","code":"MLK","typeCode":"L5","group":"l5","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture","typeCode":"L5","days":["M","W","F"],"start":540,"end":590,"location":"160 English Building","instructors":["Kraft, M"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":"Topic: Biochemical Engineering. Meets with CHBE 471."},{"crn":"31609","code":"RGM","typeCode":"L3","group":"l3","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture","typeCode":"L3","days":["T","R"],"start":660,"end":740,"location":"2200 Sidney Lu Mech Engr Bldg","instructors":["Mullen, R"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":"Computational Tools An introduction to computational tools in Python to solve problems in chemical engineering. Methods for solving nonlinear and differential equations, plotting/animation, optimization, and data modeling are discussed. Meets with CHBE 412, Section A"},{"crn":"78577","code":"YD","typeCode":"L1","group":"l1","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture","typeCode":"L1","days":["T","R"],"start":570,"end":650,"location":"4039 Campus Instructional Facility","instructors":["Diao, Y"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":"Discover essential principles, techniques, and industrial uses of self and directed assembly across scales (molecular to macro) in diverse materials, with a focus on molecular and polymeric substances. Explore intermolecular forces, surface energies, nucleation, crystal growth, phase separation, and interfacial instabilities. Lectures introduce assembly techniques and application of principles in producing materials like pharmaceuticals, fine chemicals, food products, electronics, and solar cells. Meets with CHBE 461"}]},{"id":"CHBE 597","subject":"CHBE","number":"597","title":"Special Problems","creditHours":"2 TO 16 hours","minHours":2,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"May be repeated.","linkedByLetter":false,"sections":[{"crn":"10498","code":"","typeCode":"IND","group":"ind","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Independent Study","typeCode":"IND","days":[],"start":null,"end":null,"location":"Location Pending","instructors":[]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"CHBE 598","subject":"CHBE","number":"598","title":"Research Seminar","creditHours":"0 TO 4 hours","minHours":0,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Approved for S/U grading only. May be repeated. Prerequisite: Consent of instructor.","linkedByLetter":false,"sections":[{"crn":"10501","code":"","typeCode":"IND","group":"ind","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Independent Study","typeCode":"IND","days":[],"start":null,"end":null,"location":"Location Pending","instructors":[]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]}]