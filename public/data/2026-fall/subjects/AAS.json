Letter":true,"sections":[{"crn":"71409","code":"AD1","typeCode":"DIS","group":"discussion","status":"open","statusText":"CrossListOpen","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Discussion/Recitation","typeCode":"DIS","days":["F"],"start":540,"end":590,"location":"223 David Kinley Hall","instructors":["Burgos, A","Ramirez, N"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"71413","code":"AD2","typeCode":"DIS","group":"discussion","status":"open","statusText":"CrossListOpen","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Discussion/Recitation","typeCode":"DIS","days":["F"],"start":780,"end":830,"location":"215 Davenport Hall","instructors":["Burgos, A","Leyva, I"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"71417","code":"AD3","typeCode":"DIS","group":"discussion","status":"closed","statusText":"Closed","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Discussion/Recitation","typeCode":"DIS","days":["F"],"start":660,"end":710,"location":"1024 Lincoln Hall","instructors":["Burgos, A","Leyva, I"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"75269","code":"AD4","typeCode":"DIS","group":"discussion","status":"open","statusText":"CrossListOpen","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Discussion/Recitation","typeCode":"DIS","days":["F"],"start":660,"end":710,"location":"1120 Literatures, Cultures, & Ling","instructors":["Burgos, A","Ramirez, N"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"75272","code":"AD5","typeCode":"DIS","group":"discussion","status":"open","statusText":"CrossListOpen","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Discussion/Recitation","typeCode":"DIS","days":["W"],"start":780,"end":830,"location":"315 Gregory Hall","instructors":["Burgos, A","Ramirez, N"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"75275","code":"AD6","typeCode":"DIS","group":"discussion","status":"closed","statusText":"Closed","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Discussion/Recitation","typeCode":"DIS","days":["W"],"start":840,"end":890,"location":"327 Gregory Hall","instructors":["Burgos, A","Leyva, I"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"70106","code":"AL1","typeCode":"LCD","group":"lecture","status":"open","statusText":"CrossListOpen","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M","W"],"start":660,"end":710,"location":"116 Roger Adams Laboratory","instructors":["Burgos, A"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"Topic: This introductory survey course on the social construction of race in the United States examines how various conceptions and interpretations of racial difference have changed over time in U.S. history and the ways these differences meshed with social inequalities. Specifically, we explore the ways the color line had a profound impact on everyday life. Through readings, lectures, discussion, and writing assignments, we will engage the construction of race through the realm of the law, culture, and immigration policy. We will interrogate how race was made real (and continues to be) in immigration policy, determining who was/is permitted to enter the United States as an immigrant at various historical moments, whether they were permitted to naturalize as “free white persons,” and their treatment once in U.S. society. Indeed, although it is socially constructed, race remains a very real lived experience then as now."}]},{"id":"AAS 282","subject":"AAS","number":"282","title":"Feminist and Queer Activisms","creditHours":"3 hours","minHours":3,"genEd":["1US"],"degreeAttributes":"Cultural Studies - US Minority course.","scheduleNote":"","info":"Same as GWS 282 and LLS 282. See GWS 282.","linkedByLet