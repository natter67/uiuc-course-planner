[{"id":"AFST 199","subject":"AFST","number":"199","title":"Undergraduate Open Seminar","creditHours":"1 TO 5 hours","minHours":1,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"May be repeated.","linkedByLetter":false,"sections":[{"crn":"10130","code":"","typeCode":"IND","group":"ind","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Independent Study","typeCode":"IND","days":[],"start":null,"end":null,"location":"Location Pending","instructors":[]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"AFST 209","subject":"AFST","number":"209","title":"Constr Afr and Carib Identity","creditHours":"3 hours","minHours":3,"genEd":["1NW","1LA"],"degreeAttributes":"Humanities - Lit & Arts, and Cultural Studies - Non-West course.","scheduleNote":"","info":"Same as CWL 225, FR 240, and LAST 240. See FR 240.","linkedByLetter":false,"sections":[{"crn":"32902","code":"X","typeCode":"LCD","group":"lecture","status":"open","statusText":"CrossListOpen","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":660,"end":740,"location":"1068 Lincoln Hall","instructors":["Reynolds, F"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"This course will introduce students to the diverse religions and expressions of folk spirituality among peoples of the Afro-Atlantic world, with special attention to religious and spiritual practices of the French-Creole circum-Caribbean. Special attention will be devoted to the French/Creole-speaking populations of the former French colonies (i.e. Haiti, Martinique, Louisiana). Using historical and anthropological approaches, we will explore the core concepts of religious syncretism and how the religious identities of Africans and their descendants developed under New World conditions. We will also draw upon interdisciplinary scholarship (i.e. dance studies, ethnomusicology, cultural studies) to examine the relationship between religious expression and cultural production. This will include discussions of music and dance expression, visual arts, and literature, as well as religious commodification, tourism, and critiques of media portrayals. Text, film, audio, and explorations of performance will be used in the course format."}]},{"id":"AFST 210","subject":"AFST","number":"210","title":"Introduction to Modern African Literature","creditHours":"3 hours","minHours":3,"genEd":["1NW","1LA"],"degreeAttributes":"Humanities - Lit & Arts, and Cultural Studies - Non-West course.","scheduleNote":"","info":"Same as CWL 210 and ENGL 211.","linkedByLetter":false,"sections":[{"crn":"47157","code":"P","typeCode":"LCD","group":"lecture","status":"open","statusText":"CrossListOpen","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M","W","F"],"start":660,"end":710,"location":"36 English Building","instructors":["Toure, V"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"AFST 222","subject":"AFST","number":"222","title":"Introduction to Modern Africa","creditHours":"3 hours","minHours":3,"genEd":["1NW"],"degreeAttributes":"Cultural Studies - Non-West course.","scheduleNote":"","info":"Same as ANTH 222, PS 242, and SOC 222.","linkedByLetter":false,"sections":[{"crn":"56391","code":"A","typeCode":"DIS","group":"discussion","status":"open","statusText":"CrossListOpen","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Discussion/Recitation","typeCode":"DIS","days":["F"],"start":780,"end":830,"location":"307 Gregory Hall","instructors":["Toure, V"]},{"typeName":"Lecture","typeCode":"LEC","days":["M","W"],"start":780,"end":830,"location":"307 Gregory Hall","instructors":["Toure, V"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"Modern Africa has sustained the most rapid and profound changes of any continent in the world. Indeed, the African continent saw its social systems, economic structures, political organizations, and religious and cultural practices profoundly transformed by centuries of European imperialism. Yet, Africa is still largely known in the United States through exotic images of the cultural “other,” decimated by civil wars, clan violence, famine, and HIV/AIDS. This course goes beyond these images and stereotypes to place Africa and its people within the shared history of an increasingly global world. The course will utilize an interdisciplinary framework to examine the great civilizations of pre-colonial African societies; the trans-Atlantic slave trade; the impact of colonialism, nationalism, Pan-Africanism, and nationalist and independence movements; social movements and democratization; gender and development; the role of the African Diaspora in Africa's development; and globalization. This course fulfills a general education requirement for Cultural Studies: Non-Western"}]},{"id":"AFST 232","subject":"AFST","number":"232","title":"Elementary Swahili II","creditHours":"5 hours","minHours":5,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Same as SWAH 202. See SWAH 202.","linkedByLetter":false,"sections":[{"crn":"63321","code":"A","typeCode":"LAB","group":"lab","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Laboratory","typeCode":"LAB","days":["R"],"start":600,"end":650,"location":"G7 Literatures, Cultures, & Ling","instructors":["Saadah, E","Wamalwa, K"]},{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M","T","W","F"],"start":600,"end":650,"location":"1032 Literatures, Cultures, & Ling","instructors":["Saadah, E","Wamalwa, K"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"AFST 241","subject":"AFST","number":"241","title":"Elementary Wolof I","creditHours":"5 hours","minHours":5,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Same as WLOF 201. See WLOF 201.","l