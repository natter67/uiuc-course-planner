7","code":"MK","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T"],"start":840,"end":1010,"location":"102 1205 W Nevada","instructors":["Kashani, M"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":"Please contact the instructor for permission to enroll in the class."}]},{"id":"GWS 590","subject":"GWS","number":"590","title":"Topics in GWS","creditHours":"4 hours","minHours":4,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"May be repeated. Prerequisite: Graduate standing and previous coursework in women's or gender studies, or consent of instructor.","linkedByLetter":false,"sections":[{"crn":"35062","code":"RO","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["R"],"start":660,"end":800,"location":"Location Pending","instructors":["Rosas, G"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":"Topic: Critical Border Studies Be it in Europe, the Americas, the United States, or elsewhere in the globe, there has been belligerent calls to tighten international borders, and better regulate, who can settle, who can migrate, who must leave, and who should be held. Detention, policing, and the surveillance of immigrants and refugees has augmented exponentially. Keeping the pressing presence of the present central, the course moves through theoretical shifts underscoring the frictions among questions of movement, borders, migrations, and refugee studies with respect to the debates on abolition, biopolitics, settler colonialism, and other currents."}]}]