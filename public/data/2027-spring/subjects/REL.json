Code":"LCD","days":["M","W"],"start":930,"end":1010,"location":"1062 Lincoln Hall","instructors":["Tamir, O"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"77945","code":"B","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M","W"],"start":930,"end":1010,"location":"1062 Lincoln Hall","instructors":["Tamir, O"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"REL 495","subject":"REL","number":"495","title":"Topics in Asian Religions","creditHours":"3 OR 4 hours","minHours":3,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Same as EALC 495. 3 undergraduate hours. 4 graduate hours. May be repeated to a maximum of 6 undergraduate hours or 8 graduate hours as topics vary. Prerequisite: Sophomore standing or consent of instructor.","linkedByLetter":false,"sections":[{"crn":"71847","code":"A","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"B","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M","W"],"start":720,"end":800,"location":"429 Armory","instructors":["Tosato, A"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"In this course we will study the principles of Indian religious art through a selection of primary and secondary readings, and a vast collection of images. We will learn to identify the different structures and styles of Indian sacred buildings of the classical and medieval periods, and we will explore how they served their religious purposes. Also, we will study some of the masterpieces of Hindu, Buddhist, and Jain art, highlighting the social status and agency of the artists who created them."},{"crn":"79193","code":"AN","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":840,"end":920,"location":"336 Davenport Hall","instructors":["Newman, A"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"In this course, we will examine the history, philosophy, and physical practices of yoga throughout its two-thousand-year development in South Asia. We will also investigate the ritual practices of yoga that found root in South Asia, but that eventually spread to Europe and North America as a type of secular physical exercise."},{"crn":"79194","code":"AN1","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":840,"end":920,"location":"336 Davenport Hall","instructors":["Newman, A"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"In this course, we will examine the history, philosophy, and physical practices of yoga throughout its two-thousand-year development in South Asia. We will also investigate the ritual practices of yoga that found root in South Asia, but that eventually spread to Europe and North America as a type of secular physical exercise."},{"crn":"71829","code":"AT","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"B","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M","W"],"start":720,"end":800,"location":"429 Armory","instructors":["Tosato, A"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"In this course we will study the principles of Indian religious art through a selection of primary and secondary readings, and a vast collection of images. We will learn to identify the different structures and styles of Indian sacred buildings of the classical and medieval periods, and we will explore how they served their religious purposes. Also, we will study some of the masterpieces of Hindu, Buddhist, and Jain art, highlighting the social status and agency of the artists who created them."},{"crn":"75819","code":"AT1","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"B","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":750,"end":830,"location":"163 Noyes Laboratory","instructors":["Tosato, A"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"."},{"crn":"75820","code":"AT2","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"B","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":750,"end":830,"location":"163 Noyes Laboratory","instructors":["Tosato, A"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"."},{"crn":"68097","code":"CC","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["F"],"start":780,"end":950,"location":"1118 Literatures, Cultures, & Ling","instructors":["Callahan, C"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"Course title: Death, Dying and the Dead in Japanese Buddhism Course description: From its inception, the Buddhist tradition has shown an abiding concern for death, the dying and the dead. This upper level seminar will examine the doctrinal and symbolic meanings of death, the ritual and meditative practices of the dying, as well as the treatment of the dead in the context of Japanese Buddhism. Drawing on recent secondary scholarship, we will examine the interface between doctrine and social practice in deathbed rituals, funerary practices and memorial services, the material, visual and literary culture of the dying and the dead, and the ethical and societal issues concerning death, dying and the dead in Japan."},{"crn":"68098","code":"CC1","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["F"],"start":780,"end":950,"location":"1118 Literatures, Cultures, & Ling","instructors":["Callahan, C"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"Course title: Death, Dying and the Dead in Japanese Buddhism Course description: From its inception, the Buddhist tradition has shown an abiding concern for death, the dying and the dead. This upper level seminar will examine the doctrinal and symbolic meanings of death, the ritual and meditative practices of the dying, as well as the treatment of the dead in the context of Japanese Buddhism. Drawing on recent secondary scholarship, we will examine the interface between doctrine and social practice in deathbed rituals, funerary practices and memorial services, the material, visual and literary culture of the dying and the dead, and the ethical and societal issues concerning death, dying and the dead in Japan."}]},{"id":"REL 511","subject":"REL","number":"511","title":"Seminar in Study of Religion","creditHours":"4 hours","minHours":4,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"May be repeated in the same or separates terms as topics vary.","linkedByLetter":false,"sections":[{"crn":"68627","code":"ER","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T"],"start":900,"end":1040,"location":"1118 Literatures, Cultures, & Ling","instructors":["Rosenblatt, E"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"Course Title: Introduction to Jewish Studies Course Description: This graduate seminar introduces students to methods and concerns in Jewish Studies, an interdisciplinary scholarly field that spans the humanities and social sciences. We will read newer scholarship that contributes something to distinct to the field. How do different disciplinary tools interact with “the Jews” as subject and as instrument? The socio-political conditions which gave way to the emergence of different Jewish Studies traditions in Germany, the United States and elsewhere will also be closely examined."},{"crn":"76024","code":"RL","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M"],"start":900,"end":1040,"location":"1020 Lincoln Hall","instructors":["Layton, R"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"."}]},{"id":"REL 590","subject":"REL","number":"590","title":"Independent Study","creditHours":"2 TO 6 hours","minHours":2,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"May be repeated. Prerequisite: Evidence of adequate preparation for such study and consent of staff member supervising the work.","linkedByLetter":false,"sections":[{"crn":"68427","code":"","typeCode":"IND","group":"ind","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Independent Study","typeCode":"IND","days":[],"start":null,"end":null,"location":"Location Pending","instructors":[]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"REL 280","subject":"REL","number":"280","title":"Islamic Intellectual Culture","creditHours":"3 hours","minHours":3,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Same as SAME 280. See SAME 280.","linkedByLetter":false,"sections":[{"crn":"79119","code":"AA","typeCode":"LEC","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture","typeCode":"LEC","days":["M","W"],"start":660,"end":740,"location":"303 English Building","instructors":["Ali, M"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"This course introduces the rich traditions of thought and culture in the Islamic world from the seventh to the fifteenth century. Through translated readings, students explore poetry, philosophy, cosmology, mysticism, art, and medicine while examining how Muslims understood knowledge, revelation, the human soul, gender symbolism, and sacred art. The course highlights the interconnected development of religious thought, ethical practice, scientific inquiry, and artistic expression in Islamic civilization. Designed for students from all backgrounds, it develops critical tools for interpreting religious traditions within broader humanistic and cultural frameworks. No prior knowledge of Islam is required."}]}]