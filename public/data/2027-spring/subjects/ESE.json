OfTerm":"1","dateRange":"","meetings":[{"typeName":"Online","typeCode":"ONL","days":[],"start":null,"end":null,"location":"n.a.","instructors":["Pettijohn, C"]}],"restrictions":["Restricted to NDEG:Graduate OR - UIUC."],"coRequest":null,"specialApproval":null,"sectionText":"Restricted to Environmental Sustainability graduate certificate students."}]},{"id":"ESE 497","subject":"ESE","number":"497","title":"Special Topics in ESE","creditHours":"1 TO 4 hours","minHours":1,"genEd":[],"degreeAttributes":"","scheduleNote":"Field trip fee required for some sections.","info":"Additional fees may apply. See Class Schedule. 1 to 4 undergraduate hours. 1 to 4 graduate hours. Approved for letter and S/U grading. May be repeated in the same or separate terms to a maximum of 12 undergraduate hours or 8 graduate hours. Prerequisite: Consent of instructor.","linkedByLetter":false,"sections":[{"crn":"77884","code":"M","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M","W","F"],"start":780,"end":830,"location":"122 Davenport Hall","instructors":["Christie, M","Meghani, N"]},{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M"],"start":840,"end":950,"location":"122 Davenport Hall","instructors":["Christie, M","Meghani, N"]}],"restrictions":["Restricted to Geology or Earth, Soc, Env Sustainability or Environmental Sustainability major(s)."],"coRequest":null,"specialApproval":null,"sectionText":"Environmental scientists rely on a diverse array of tools, technologies, and analytical techniques to investigate and address environmental challenges. This hands-on field-based course introduces students to essential components of the environmental scientist’s toolkit, including data collection, processing, interpretation, and presentation of findings. Students will gain experience in developing and executing site assessment plans, and use drones, RTK GPS units, LiDAR, surveying equipment, and water quality sensors to gather field data. They will then process and analyze these data using structure-from-motion photogrammetry, ENVI, Google Earth Engine, open-source GIS platforms, and Python-based workflows, and write summaries and recommendations to stakeholders. 4 Credit Hours. Standard letter graded."}]},{"id":"ESE 498","subject":"ESE","number":"498","title":"Environmental Writing for Publication","creditHours":"3 hours","minHours":3,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Same as ENGL 498. 3 undergraduate hours. No graduate credit. Prerequisite: Consent of instructor.","linkedByLetter":false,"sections":[{"crn":"67478","code":"A","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":750,"end":830,"location":"G48 Literatures, Cultures, & Ling","instructors":["Cole, L"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"SP26 - ENGL / ESE 498 - Environmental Writing for Publication - Lucinda Cole - engages students in the real-world editorial process as they develop a polished piece of long-form journalism on an environmental topic of their choice. This final product will showcase students’ professional development as well-informed writers on environmental issues, and may be published in Q Magazine."}]}]