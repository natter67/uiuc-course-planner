ull}]},{"id":"LA 370","subject":"LA","number":"370","title":"Environmental Sustainability","creditHours":"3 hours","minHours":3,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Same as ENSU 300 and NRES 370. See ENSU 300.","linkedByLetter":false,"sections":[{"crn":"77855","code":"A","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":840,"end":920,"location":"2020A Natural History Building","instructors":["Tomkin, J"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"77865","code":"B","typeCode":"ONL","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Online","typeCode":"ONL","days":[],"start":null,"end":null,"location":"n.a.","instructors":["Tomkin, J"]}],"restrictions":["Restricted to Earth, Soc, Env Sustainability major(s)."],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"LA 387","subject":"LA","number":"387","title":"Undergraduate Seminar","creditHours":"1 TO 6 hours","minHours":1,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Additional fees may apply. See Class Schedule. May be repeated to a maximum of 6 hours if topics vary. Prerequisite: Restricted to students with junior or senior standing.","linkedByLetter":false,"sections":[{"crn":"75970","code":"BD","typeCode":"ONL","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Online","typeCode":"ONL","days":[],"start":null,"end":null,"location":"n.a.","instructors":["Deal, B"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"This course will provide an overview of energy as it relates to landscape and landscape design from global to community perspectives. Students will generally understand energy systems and urban landscapes, its impact on climate, and potential community scaled responses and how to apply it in design. This is an asynchronous online course."},{"crn":"73469","code":"DH","typeCode":"SEM","group":"sem","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Seminar","typeCode":"SEM","days":["T","R"],"start":750,"end":830,"location":"325 Temple Hoyne Buell Hall","instructors":["Hays, D"]}],"restrictions":[],"coRequest":null,"specialApproval":"Instructor Approval Required","sectionText":"As a relationship between humans and nature, landscape is not bound to any specific medium. Instead, it is negotiated through a wide range of media. This seminar examines the theory and practice of landscape as a relational condition. Participants will explore twelve works of landscape in diverse media in order to understand how their terms are defined and negotiated. Through shared firsthand experience, close analysis, and interpretation, with pertinent scholarly supports, students will address questions of agency, purpose, and meaning alongside practical concerns such as materiality, technique, and context. As a semester-long project, each student will develop and self-publish an original zine in a print edition of 20, interpreting and influencing the contemporary situation of landscape through a lens of personal understandings, priorities, and aspirations."}]},{"id":"LA 390","subject":"LA","number":"390","title":"Independent Study I","creditHours":"1 TO 6 hours","minHours":1,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"May be repeated to a maximum of 6 hours. Prerequisite: Junior or senior standing, or consent of instructor. Consent of instructor prior to registration.","linkedByLetter":false,"sections":[{"crn":"10488","code":"","typeCode":"IND","group":"ind","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Independent Study","typeCode":"IND","days":[],"start":null,"end":null,"location":"Location Pending","instructors":[]}],"res