,"end":null,"location":"n.a.","instructors":["Atiles, A"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":"Online asynchronous (no scheduled class times)"},{"crn":"36408","code":"U3","typeCode":"ONL","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Online","typeCode":"ONL","days":[],"start":null,"end":null,"location":"n.a.","instructors":["Atiles, A"]}],"restrictions":["Restricted to Undergrad - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":"Online asynchronous (no scheduled class times)"}]},{"id":"LING 403","subject":"LING","number":"403","title":"Introduction to Field Methods","creditHours":"3 OR 4 hours","minHours":3,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"3 undergraduate hours. 4 graduate hours. May be repeated in separate semesters for up to 6 undergraduate hours or 8 graduate hours, if topics vary or if a new language is in the focus of investigation. Prerequisite: LING 301 and LING 302 or LING 401.","linkedByLetter":false,"sections":[{"crn":"70580","code":"G4","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M","W"],"start":780,"end":860,"location":"1126 Literatures, Cultures, & Ling","instructors":["Talic, A"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":"This is a hands-on (learn-by-doing) practical course in elicitation of linguistic data, and theoretical analysis of that data, from an unfamiliar language. Students will elicit, record, and transcribe data collected in group interviews. The class as a whole will work on a language archive: (i) recordings collected throughout the semester and their transcriptions, (ii) a dictionary with vocabulary translated into English, (iii) the final projects. This course provides advanced undergraduate students with the opportunity to integrate their previous training with this practical experience and the class will depend on the experience they have up to date with phonology, phonetics, morphology, syntax, semantics. Prerequisites: LING 301, LING 302, and one of the following courses: LING 304 or LING 307."},{"crn":"70579","code":"U3","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M","W"],"start":780,"end":860,"location":"1126 Literatures, Cultures, & Ling","instructors":["Talic, A"]}],"restrictions":["Restricted to Undergrad - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":"This is a hands-on (learn-by-doing) practical course in elicitation of linguistic data, and theoretical analysis of that data, from an unfamiliar language. Students will elicit, record, and transcribe data collected in group interviews. The class as a whole will work on a language archive: (i) recordings collected throughout the semester and their transcriptions, (ii) a dictionary with vocabulary translated into English, (iii) the final projects. This course provides advanced undergraduate students with the opportunity to integrate their previous training with this practical experience and the class will depend on the experience they have up to date with phonology, phonetics, morphology, syntax, semantics. Prerequisites: LING 301, LING 302, and one of the following courses: LING 304 or LING 307."}]},{"id":"LING 404","subject":"LING","number":"404","title":"Tutorials in Non-Western Lang","creditHours":"1 TO 5 hours","minHours":1,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"1 to 5 undergraduate hours. 2 to 4 graduate hours. May be repeated with approval. Prerequisite: Consent of instructor.","linkedByLetter":false,"sections":[{"crn":"36461","code":"HND","typeCode":"LCD","group":