,"end":800,"location":"819 Psychology Building","instructors":["Hotaling, J"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"56345","code":"CPS","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["F"],"start":660,"end":710,"location":"32 Psychology Building","instructors":["Derringer, J"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":"This class is held at the PSC."},{"crn":"54904","code":"DEV","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["F"],"start":810,"end":890,"location":"819 Psychology Building","instructors":["Hyde, D"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"68144","code":"DPC","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["W"],"start":840,"end":920,"location":"708 Psychology Building","instructors":["Hankin, B"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"68424","code":"ES","typeCode":"S6","group":"s6","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"S6","days":["M"],"start":600,"end":690,"location":"819 Psychology Building","instructors":["Seaton, E"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":"Psych 598: Proseminar in Antiracist Science Racism is a system of power, privilege and dominance which advantages White individuals and White communities at the expense of non-White individuals and communities (Feagin & McKinney, 2003; Harrell, 2000). Although psychological science is considered objective, racism exists within psychological research (Buchanan et al., 2021; Roberts et al., 2020; Roberts & Rizzo, 2021). Antiracism includes a critical understanding of racism, Whiteness, and White privilege, and consistent behaviors that challenge racism (Helms, 2017). “Anti-racist research involves understanding and situating racism within societal systems and policies and conducting research that aims to challenge and eradicate racism. Anti-racist research is thus essential to the work of dismantling systems of racism and oppression” (Wray-Lake et al., 2022, p. 1286). Psych 598 is a multi-year proseminar designed to educate faculty and students on conducting antiracist psychological research. Invited speakers will come from subdisciplines within the field of psychology."},{"crn":"64411","code":"IN2","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":[],"start":null,"end":null,"location":"Location Pending","instructors":["Fisher, C"]}],"restrictions":[],"coRequest":null,"specialApproval":"Instructor Approval Required","sectionText":"Predoctoral Social-Personality Psychology Internship is available to doctoral candidates in the Social-Personality Division in order to gain professional skills."},{"crn":"54906","code":"IO","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["R"],"start":600,"end":680,"location":"819 Psychology Building","instructors":["Newman, D"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":"IO Journal Club"},{"crn":"61068","code":"JH","typeCode":"LCD","group":"le