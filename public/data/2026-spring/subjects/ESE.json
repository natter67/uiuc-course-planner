equest":null,"specialApproval":null,"sectionText":null}]},{"id":"ESE 379","subject":"ESE","number":"379","title":"Introduction to Geographic Information Systems","creditHours":"4 hours","minHours":4,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Same as GGIS 379. See GGIS 379.","linkedByLetter":false,"sections":[{"crn":"54798","code":"AE1","typeCode":"LEC","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture","typeCode":"LEC","days":["W"],"start":840,"end":950,"location":"1090 Lincoln Hall","instructors":["Minn, M"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"62098","code":"ONL","typeCode":"ONL","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Online","typeCode":"ONL","days":[],"start":null,"end":null,"location":"n.a.","instructors":["Minn, M"]}],"restrictions":["Restricted to BSLAS: ESES Online - UIUC."],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"ESE 380","subject":"ESE","number":"380","title":"Geographic Information Systems II","creditHours":"4 hours","minHours":4,"genEd":["1QR2"],"degreeAttributes":"Quantitative Reasoning II course.","scheduleNote":"","info":"Same as GGIS 380. See GGIS 380.","linkedByLetter":false,"sections":[{"crn":"61528","code":"A","typeCode":"LBD","group":"lab","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Laboratory-Discussion","typeCode":"LBD","days":["T","R"],"start":840,"end":920,"location":"1020 Natural History Building","instructors":["Minn, M"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"ESE 389","subject":"ESE","number":"389","title":"Environment and Sustainability Field Expedition","creditHours":"3 hours","minHours":3,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Additional fees may apply. See Class Schedule. May be repeated up to 12 hours in separate terms if topics vary.","linkedByLetter":false,"sections":[{"crn":"62068","code":"A","typeCode":"DIS","group":"discussion","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Discussion/Recitation","typeCode":"DIS","days":["W"],"start":960,"end":1040,"location":"2020A Natural History Building","instructors":["Meghani, N"]}],"restrictions":["Restricted to BSLAS: Earth,Soc,Env Sust-UIUC."],"coRequest":null,"specialApproval":null,"sectionText":"3 hours. Field expedition to Costa Rica over spring break (approx. 9 days), and weekly seminar. This course uses Costa Rica as a case study to examine issues of sustainability and the environment. Topics include rainforest ecology, land-use issues, sustainable agriculture, global versus local economies, and geologic features of the landscape, including volcanoes and rivers. Estimated program fee of $4,500; scholarships from college and dept. available. Primarily for ESES majors and Unit One Living Learning Community Students but others are encouraged to apply in case spots remain available. Enrollment is through LAS Abroad. Apply at: <a href=\"https://app.studyabroad.illinois.edu/index.cfm?FuseAction=Programs.ViewProgramAngular&id=11881\">ESE 389 Application</a> Applications submitted prior to October 16 will be given priority."}]},{"id":"ESE 401","subject":"ESE","number":"401","title":"ESE Capstone","creditHours":"3 hours","minHours":3,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"3 undergraduate hours. No graduate credit. Approved for Letter and S/U grading. May be repeated once.","linkedByLetter":false,"sections":[{"crn":"54841","code":"","typeCode":"IND","group":"ind","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Independent Study","typeCode":"IND","days":[],"start":null,"end":null,"location":"Location Pending","instructors":[]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"ESE 439","subject":"ESE","number":"439","title":"Biogeography","creditHours":"3 hours","minHours":3,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Same as ANTH 436, GGIS 436, IB 439, and NRES 441. See IB 439.","linkedByLetter":false,"sections":[{"crn":"56936","code":"A","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":570,"end":650,"location":"2083 Natural History Building","instructors":["Punyasena, S"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"ESE 445","subject":"ESE","number":"445","title":"Earth Resources Sustainability","creditHours":"3 hours","minHours":3,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"3 undergraduate hours. 3 graduate hours. Credit is not given for both ESE 445 and GEOL 380. Prerequisite: Junior standing or higher.","linkedByLetter":false,"sections":[{"crn":"61711","code":"A","typeCode":"ONL","group":"lecture","status":"unknown","statusText":"","partOfTerm":"B","dateRange":"","meetings":[{"typeName":"Online","typeCode":"ONL","days":[],"start":null,"end":null,"location":"n.a.","instructors":["Cole, T"]}],"restrictions":["Restricted to Earth, Soc, Env Sustainability major(s)."],"coRequest":null,"specialApproval":null,"sectionText":"ESE and iSEE minors are welcome to enroll. Please send your UIN to tomkin@illinois.edu to request an override."}]},{"id":"ESE 467","subject":"ESE","number":"467","title":"Multimedia Environmental Communications","creditHours":"3 OR 4 hours","minHours":3,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Same as ENGL 467. 3 undergraduate hours. 4 graduate hours.","linkedByLetter":false,"sections":[{"crn":"70523","code":"A","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":930,"end":1010,"location":"1128 Literatures, Cultures, & Ling","instructors":["Becker, L"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"ESE 497","subject":"ESE","number":"497","title":"Special Topics in ESE","creditHours":"1 TO 4 hours","minHours":1,"genEd":[],"degreeAttributes":"","scheduleNote":"Field trip fee required for some sections.","info":"Additional fees may apply. See Class Schedule. 1 to 4 undergraduate hours. 1 to 4 graduate hours. Approved for letter and S/U grading. May be repeated in the same or separate terms to a maximum of 12 undergraduate hours or 8 graduate hours. Prerequisite: Consent of instructor.","linkedByLetter":false,"sections":[{"crn":"76924","code":"I","typeCode":"ONL","group":"lecture","status":"unknown","statusText":"","partOfTerm":"B","dateRange":"03/16/26-05/06/26","meetings":[{"typeName":"Online","typeCode":"ONL","days":[],"start":null,"end":null,"location":"n.a.","instructors":["Brown, C"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"This course examines environmental quality associated to human activities and its associated impacts to human life supporting condition. A Healthy, Resilient and Robust human condition is a significant component of social sustainability and climate change mitigation measures. This course will provide competencies in understanding the interconnections of human health, the state of the environment, the evaluation and assessment of social and environmental sustainability."},{"crn":"77884","code":"M","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M","W","F"],"start":780,"end":830,"location":"122 Davenport Hall","instructors":["Christie, M","Meghani, N"]},{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M"],"start":840,"end":950,"location":"122 Davenport Hall","instructors":["Christie, M","Meghani, N"]}],"restrictions":["Restricted to Geology or Earth, Soc, Env Sustainability major(s)."],"coRequest":null,"specialApproval":null,"sectionText":"Environmental scientists rely on a diverse array of tools, technologies, and analytical techniques to investigate and address environmental challenges. This hands-on field-based course introduces students to essential components of the environmental scientist’s toolkit, including data collection, processing, interpretation, and presentation of findings. Students will gain experience in developing and executing site assessment plans, and use drones, RTK GPS units, LiDAR, surveying equipment, and water quality sensors to gather field data. They will then process and analyze these data using structure-from-motion photogrammetry, ENVI, Google Earth Engine, open-source GIS platforms, and Python-based workflows, and write summaries and recommendations to stakeholders. 4 Credit Hours. Standard letter graded."}]},{"id":"ESE 498","subject":"ESE","number":"498","title":"Environmental Writing for Publication","creditHours":"3 hours","minHours":3,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Same as ENGL 498. 3 undergraduate hours. No graduate credit. Prerequisite: Consent of instructor.","linkedByLetter":false,"sections":[{"crn":"67478","code":"A","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":750,"end":830,"location":"G48 Literatures, Cultures, & Ling","instructors":["Cole, L"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"SP26 - ENGL / ESE 498 - Environmental Writing for Publication - Lucinda Cole - engages students in the real-world editorial process as they develop a polished piece of long-form journalism on an environmental topic of their choice. This final product will showcase students’ professional development as well-informed writers on environmental issues, and may be published in Q Magazine."}]}]