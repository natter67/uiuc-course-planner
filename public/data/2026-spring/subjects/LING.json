ecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M","W","F"],"start":600,"end":650,"location":"329 Gregory Hall","instructors":["Zhang, Q"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"61828","code":"U3","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M","W","F"],"start":600,"end":650,"location":"329 Gregory Hall","instructors":["Zhang, Q"]}],"restrictions":["Restricted to Undergrad - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"LING 490","subject":"LING","number":"490","title":"Special Topics in Linguistics","creditHours":"3 OR 4 hours","minHours":3,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"3 undergraduate hours. 4 graduate hours. May be repeated as topic varies to a maximum of 9 undergraduate hours or 12 graduate hours. Students may register for up to two sections in the same term. Prerequisite: LING 100, LING 400, or consent of instructor.","linkedByLetter":false,"sections":[{"crn":"36498","code":"G4","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":930,"end":1010,"location":"1120 Literatures, Cultures, & Ling","instructors":["Nelson, S"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":"Title: Learnability and Linguistic Theory Description: How an individual learns a language is a central question of linguistic inquiry. In order to answer this question, one first needs to define what it means to learn. In this class we will study computational learning theory and its relationship to linguistic theory. Computational learning theory provides mathematical definitions of learning and therefore provides a rigorous framework for thinking about how humans learn. The target audience for this course includes (1) students interested in language acquisition/psycholinguistics who might ask questions like, \"what type of learning trajectories should we expect given different ideas about what it means to learn/what input data a learner receives?\" (2) students interested in linguistic theory who might ask, \"are the theories that we have proposed learnable under real conditions present in the natural world?\" (3) computational linguistics students interested in questions like, \"how do formal constraints on learning interact with empirical tests used in modern machine learning?\" or \"how do I evaluate my model to ensure that it has actually learned the pattern I want it to learn?\" Prerequisites include LING 301 and LING 302 (or a similar set of courses), as well as comfort with formal notation. A prior class on machine learning is recommended but not required."},{"crn":"45941","code":"UG3","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":930,"end":1010,"location":"1120 Literatures, Cultures, & Ling","instructors":["Nelson, S"]}],"restrictions":["Restricted to Undergrad - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":"Title: Learnability and Linguistic Theory Description: How an individual learns a language is a central question of linguistic inquiry. In order to answer this question, one first needs to define what it means to learn. In this class we will study computational learning theory and its relationship to linguistic theory. Computational learning theory provides mathematical definitions of learning and therefore provides a rigorous framework for thinking about how humans learn. The target audience for this course includes (1) students interested in language acquisition/psycholinguistics who might ask questions like, \"what type of learning trajectories should we expect given different ideas about what it means to learn/what input data a learner receives?\" (2) students interested in linguistic theory who might ask, \"are the theories that we have proposed learnable under real conditions present in the natural world?\" (3) computational linguistics students interested in questions like, \"how do formal constraints on learning interact with empirical tests used in modern machine learning?\" or \"how do I evaluate my model to ensure that it has actually learned the pattern I want it to learn?\" Prerequisites include LING 301 and LING 302 (or a similar set of courses), as well as comfort with formal notation. A prior class on machine learning is recommended but not required."}]},{"id":"LING 514","subject":"LING","number":"514","title":"Design and Methodology in Linguistic Research","creditHours":"4 hours","minHours":4,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Prerequisite: LING 400 or equivalent; LING 425, or EIL 489 or consent of instructor.","linkedByLetter":false,"sections":[{"crn":"36532","code":"H","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":660,"end":740,"location":"1120 Literatures, Cultures, & Ling","instructors":["Ionin, T"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"LING 541","subject":"LING","number":"541","title":"Syntax II","creditHours":"4 hours","minHours":4,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Prerequisite: LING 501 or consent of instructor.","linkedByLetter":false,"sections":[{"crn":"36547","code":"C","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"t