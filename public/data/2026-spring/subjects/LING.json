methods studies."},{"crn":"38727","code":"SM","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"A","dateRange":"01/20/26-03/13/26","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":750,"end":830,"location":"G18 Literatures, Cultures, & Ling","instructors":["Montrul, S"]},{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":840,"end":890,"location":"ARR Literatures, Cultures, & Ling","instructors":["Montrul, S"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":"TOPIC TITLE: Language Transfer in L2/L3 Learning. Class meets in G18 at 12:30 PM then moves to G70 at 2:00 PM."},{"crn":"38725","code":"WM","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["W"],"start":900,"end":1070,"location":"69 English Building","instructors":["Nelson, S"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":"Topic Title: Advanced Analytical Methods for Linguistic Research Course Description: This course offers an overview of advanced analytical methods relevant to linguistic research. The emphasis will be on a critical evaluation of current methodologies, with a focus on scientific reproducibility and transparency. As a prerequisite, students are expected to be familiar with basic statistical terms and inferential statistics. The course will utilize the R software environment for teaching."}]}]