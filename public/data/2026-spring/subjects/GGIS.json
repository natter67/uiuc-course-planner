:["M","W"],"start":780,"end":860,"location":"338 Davenport Hall","instructors":["Umar, U"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":"Prerequisite courses (GGIS 379 & 380) are not required for the graduate (G) section."},{"crn":"74193","code":"UG","typeCode":"LBD","group":"lab","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Laboratory-Discussion","typeCode":"LBD","days":["M","W"],"start":780,"end":860,"location":"338 Davenport Hall","instructors":["Umar, U"]}],"restrictions":["Restricted to Undergrad - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"GGIS 491","subject":"GGIS","number":"491","title":"Research in Geography","creditHours":"2 hours","minHours":2,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"2 undergraduate hours. 2 graduate hours. Prerequisite: GGIS 471; either graduate standing in geography or senior standing as a geography major and consent of department.","linkedByLetter":false,"sections":[{"crn":"74194","code":"A","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T"],"start":840,"end":950,"location":"2084 Natural History Building","instructors":["Rhoads, B"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"GGIS 495","subject":"GGIS","number":"495","title":"Advanced Topics in Geography","creditHours":"3 OR 4 hours","minHours":3,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"3 or 4 undergraduate hours. 3 or 4 graduate hours. May be repeated if topics vary in the same term to a maximum of 9 undergraduate hours or 12 graduate hours or in separate terms to a maximum of 12 undergraduate hours or 12 graduate hours.","linkedByLetter":false,"sections":[{"crn":"74195","code":"SZ3","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M","W"],"start":630,"end":710,"location":"2084 Natural History Building","instructors":["Zaragocin, S"]}],"restrictions":["Restricted to Undergrad - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"75452","code":"SZ4","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M","W"],"start":630,"end":710,"location":"2084 Natural History Building","instructors":["Zaragocin, S"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":"This course examines the dialectical relationship between gender and the social construction of space. Students will engage with key themes in feminist geography, including gender, space and place, embodiment and everyday life, and intersectionality. Moving across multiple scales—from the body to the world system—we will explore how gender, sexuality, race, class, and coloniality shape spatial relations in diverse contexts. The course draws on feminist geographic scholarship from both the Global North and the Global South, emphasizing how feminist methodologies—such as reflexivity, translation, participatory research, social cartography, and embodied methods—can produce more equitable and transformative understandings of geography."}]},{"id":"GGIS 517","subject":"GGIS","number":"517","title":"Geospatial Visualization & Visual Analytics","creditHours":"4 hours","minHours":4,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"","linkedByLetter":false,"sections":[{"crn":"74204","code":"MS","typeCode":"ONL","group":"lecture","status":"unknown","statusText":"","partOfTerm":"A","dateRange":"","meetings":[{"typeName":"Online","typeCode":"ONL","days":[],"start":null,"end":null,"location":"n.a.","instructors":["Portelli, R"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign.","Restricted to NDEG:WeatherClimteRA ONL-UIUC, MS:WeatherClimteRA ONL-UIUC, MS:Environ Geology ONL-UIUC, NDEG:Environ Geology ONL-UIUC, MS:GIS & Data Sci ONL - UIUC, or NDEG:GIS & Data Sci ONL -UIUC."],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"74197","code":"ONL","typeCode":"ONL","group":"lecture","status":"unknown","statusText":"","partOfTerm":"A","dateRange":"","meetings":[{"typeName":"Online","typeCode":"ONL","days":[],"start":null,"end":null,"location":"n.a.","instructors":["Portelli, R"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"GGIS 570","subject":"GGIS","number":"570","title":"Advanced Spatial Analysis","creditHours":"4 hours","minHours":4,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"","linkedByLetter":false,"sections":[{"crn":"74205","code":"MS","typeCode":"ONL","group":"lecture","status":"unknown","statusText":"","partOfTerm":"B","dateRange":"","meetings":[{"typeName":"Online","typeCode":"ONL","days":[],"start":null,"end":null,"location":"n.a.","instructors":["Portelli, R"]}],"restrictions":["Restricted to NDEG:WeatherClimteRA ONL-UIUC, MS:WeatherClimteRA ONL-UIUC, MS:Environ Geology ONL-UIUC, NDEG:Environ Geology ONL-UIUC, MS:GIS & Data Sci ONL - UIUC, or NDEG:GIS & Data Sci ONL -UIUC."],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"74198","code":"ONL","typeCode":"ONL","group":"lecture","status":"unknown","statusText":"","partOfTerm":"B","dateRange":"","meetings":[{"typeName":"Online","typeCode":"ONL","days":[],"start":null,"end":null,"location":"n.a.","instructors":["Portelli, R"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign.","Not intended for NDEG:WeatherClimteRA ONL-UIUC, MS:WeatherClimteRA ONL-UIUC, MS:Environ Geology ONL-UIUC, NDEG:Environ Geology ONL-UIUC, MS:GIS & Data Sci ONL - UIUC, or NDEG:GIS & Data Sci ONL -UIUC."],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"GGIS 590","subject":"GGIS","number":"590","title":"Graduate Independent Study","creditHours":"1 TO 8 hours","minHours":1,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"May be repeated in separate semesters. After passing the Preliminary Exam, PhD candidates should register for GGIS 599: Thesis Research instead of this course.","linkedByLetter":false,"sections":[{"crn":"74403","code":"","typeCode":"IND","group":"ind","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Independent Study","typeCode":"IND","days":[],"start":null,"end":null,"location":"Location Pending","instructors":[]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"This CRN is not valid for registration. Please complete a <a href=\"https://forms.illinois.edu/sec/588652372\">GGIS 590 Independent Study</a> webform to get your faculty advisor's unique CRN."}]},{"id":"GGIS 593","subject":"GGIS","number":"593","title":"Geography & GIS Colloquium","creditHours":"0 hours","minHours":0,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"0 graduate hours. 0 professional hours. Approved for S/U grading only. May be repeated in separate terms.","linkedByLetter":false,"sections":[{"crn":"74200","code":"FRI","typeCode":"SEM","group":"sem","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Seminar","typeCode":"SEM","days":["F"],"start":900,"end":960,"location":"2049 Natural History Building","instructors":["Zaragocin, S"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"GGIS 594","subject":"GGIS","number":"594","title":"Seminar in Social Geography","creditHours":"4 hours","minHours":4,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"May be repeated up to 8 hours, if topics and instructor vary.","linkedByLetter":false,"sections":[{"crn":"75923","code":"DW","typeCode":"SEM","group":"sem","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Seminar","typeCode":"SEM","days":["W"],"start":840,"end":1010,"location":"137C Davenport Hall","instructors":["Wilson, D"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"This course examines the rise and persistence of new urban inequalities across the globe. We explore growing divides between urbanized people that permeate the domains of housing, waged work relations, city redevelopment, city economic restructuring, and city morphology. The city is excavated as a globally, nationally and regionally entangled terrain – the urban -- that suffers from growing socio-spatial polarization and demographic splintering. Cities as diverse as Chicago, Mexico City, Miami, Jakarta, Prague, Detroit, and will be critically explored as laboratories to understand emerging and persistent inequalities. Innovative theories of contemporary inequalities will be drawn from the work of such urbanists as David Harvey, Doreen Massey, Ananya Roy, Frantz Fanon, Neil Smith, Ruthie Gilmore, William Julius Wilson, and Henri Lefebvre."}]},{"id":"GGIS 595","subject":"GGIS","number":"595","title":"Graduate Seminar","creditHours":"1 TO 4 hours","minHours":1,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Approved for Letter and S/U grading. May be repeated if topics vary.","linkedByLetter":false,"sections":[{"crn":"74201","code":"RIV","typeCode":"SEM","group":"sem","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Seminar","typeCode":"SEM","days":["T"],"start":540,"end":710,"location":"2049 Natural History Building","instructors":["Rhoads, B"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"River and Nutrient Dynamics | River systems serve as important conveyors of sediment and nutrients in landscapes. The supply of sediment and nutrients to rivers can either come from the landscape surrounding the river system (e.g. soil erosion) or from within the river system itself (erosion of channel bed and banks). The delivery and fate of transported material has important implications for water quality and river channel stability. This seminar will explore the connection between river and nutrient dynamics by focusing specifically on the connection between river-channel erosion and the fate of sediment-adsorbed phosphorus. This connection is the focus of intensive societal interest given pending regulations aimed at limiting the amount of phosphorus within rivers and lakes"}]},{"id":"GGIS 598","subject":"GGIS","number":"598","title":"Graduate Capstone Project","creditHours":"4 hours","minHours":4,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"","linkedByLetter":false,"sections":[{"crn":"74405","code":"","typeCode":"IND","group":"ind","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Independent Study","typeCode":"IND","days":[],"start":null,"end":null,"location":"Location Pending","instructors":[]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"This CRN is not valid for registration. Please visit <a href=\"https://go.illinois.edu/GGIS-Capstone\">go.illinois.edu/GGIS-Capstone</a> to find your project advisor's CRN."}]},{"id":"GGIS 599","subject":"GGIS","number":"599","title":"Thesis Research","creditHours":"0 TO 16 hours","minHours":0,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Approved for S/U grading only. May be repeated in separate terms.","linkedByLetter":false,"sections":[{"crn":"75024","code":"BJJ","typeCode":"IND","group":"ind","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Independent Study","typeCode":"IND","days":[],"start":null,"end":null,"location":"Location Pending","instructors":["Jefferson, B"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign.","Restricted to PHD:Geography - UIUC."],"coRequest":null,"specia