["F"],"start":780,"end":830,"location":"136 Davenport Hall","instructors":["Stokes, A","Traill, A"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"38767","code":"ADN","typeCode":"DIS","group":"discussion","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Discussion/Recitation","typeCode":"DIS","days":["F"],"start":720,"end":770,"location":"136 Davenport Hall","instructors":["Stokes, A","Traill, A"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"52436","code":"ADP","typeCode":"DIS","group":"discussion","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Discussion/Recitation","typeCode":"DIS","days":["F"],"start":660,"end":710,"location":"164 Noyes Laboratory","instructors":["Rutherford, K","Traill, A"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"38757","code":"AL1","typeCode":"LEC","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture","typeCode":"LEC","days":["T","R"],"start":660,"end":710,"location":"AUD Foellinger Auditorium","instructors":["Traill, A"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"Day1Access course materials cost $23.60. For more information see https://go.illinois.edu/Day1Access."}]},{"id":"CLCV 116","subject":"CLCV","number":"116","title":"Introduction to Ancient Roman Culture","creditHours":"3 hours","minHours":3,"genEd":["1HP","1WCC"],"degreeAttributes":"Humanities - Hist & Phil, and Cultural Studies - Western course.","scheduleNote":"","info":"","linkedByLetter":false,"sections":[{"crn":"31331","code":"A","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":840,"end":920,"location":"101 Armory","instructors":["Fenton, V","Reeber, J"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"CLCV 120","subject":"CLCV","number":"120","title":"The Classical Tradition","creditHours":"3 hours","minHours":3,"genEd":["1WCC","1LA"],"degreeAttributes":"Humanities - Lit & Arts, and Cultural Studies - Western course.","scheduleNote":"","info":"","linkedByLetter":false,"sections":[{"crn":"70179","code":"B","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M","W","F"],"start":600,"end":650,"location":"1110 Literatures, Cultures, & Ling","instructors":["Hadjipolycarpou, M"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"Modern Greek and Greek American Culture: A postcolonial perspective. This course examines the cultural, historical, and social production of modern Greek and Greek American identity through a postcolonial lens. Students will explore Greece’s complex positioning as both a “cradle of Western civilization” and a semi-peripheral nation shaped by empire, colonial legacies, and global power structures. The course traces the formation of Greek national identity, folklore, language, literature, music, and religious practices, as well as the experiences of Greek diasporic communities in the United States. The course emphasizes the interplay between local, national, and transnational contexts, encouraging students to consider how Greece and its diaspora negotiate race, gender, class, and global hierarchies."},{"crn":"70713","code":"C","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"B","dateRange":"03/16/26-05/06/26","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M","W"],"start":840,"end":950,"location":"215B David Kinley Hall","instructors":["Hadjipolycarpou, M"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"Storytelling and Transformation: Narratives of Self from Homer to Ariana Huffington. This course explores storytelling and its junctures with the idea of self from the past to the present. We trace the beginnings of this phenomenon in the Odyssey and see its evolution through time in Europe and Modern Greece to end the course with a discussion about the role of storytelling in entrepreneurial culture in the United States today. Students become acquainted with important concepts, topics, and terms in the classical tradition and reception and develop their own definitions as they engage in conversation about modern contexts."}]},{"id":"CLCV 132","subject":"CLCV","number":"132","title":"Class Archaeology, Rome-Italy","creditHours":"3 hours","minHours":3,"genEd":["1WCC","1HP"],"degreeAttributes":"Humanities - Hist & Phil, and Cultural Studies - Western course.","scheduleNote":"","info":"","linkedByLetter":false,"sections":[{"crn":"31336","code":"A","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M","W","F"],"start":660,"end":710,"location":"307 Gregory Hall","instructors":["Bevis, B"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"CLCV 199","subject":"CLCV","number":"199","title":"Undergraduate Open Seminar","creditHours":"1 TO 5 hours","minHours":1,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Approved for both letter and S/U grading. May be repeated.","linkedByLetter":false,"sections":[{"crn":"10535","code":"","typeCode":"IND","group":"ind","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Independent Study","typeCode":"IND","days":[],"start":null,"end":null,"location":"Location Pending","instructors":[]}],"restrictions":[],"coRequest":null,"specialApproval":"Instructor Approval Required","sectionText":null},{"crn":"47177","code":"AA","typeCode":"IND","group":"ind","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Independent Study","typeCode":"IND","days":[],"start":null,"end":null,"location":"Location Pending","instructors":["Augoustakis, A"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"Classical Allusions in Cinema"}]},{"id":"CLCV 203","subject":"CLCV","number":"203","title":"Ancient Philosophy","creditHours":"4 hours","minHours":4,"genEd":["1HP"],"degreeAttributes":"Humanities - Hist & Phil course.","scheduleNote":"","info":"Same as PHIL 203. See PHIL 203.","linkedByLetter":false,"sections":[{"crn":"59285","code":"N","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M","W","F"],"start":840,"end":890,"location":"2055 Sidney Lu Mech Engr Bldg","instructors":["Biondi, Z"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"CLCV 220","subject":"CLCV","number":"220","title":"Exploring the Greek and Roman World","creditHours":"3 hours","minHours":3,"genEd":["1LA","1WCC"],"degreeAttributes":"Humanities - Lit & Arts, and Cultural Studies - Western course.","scheduleNote":"","info":"Same as CWL 220. May be repeated in separate terms, if topics vary.","linkedByLetter":false,"sections":[{"crn":"74763","code":"A","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"B","dateRange":"03/16/26-05/06/26","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":540,"end":650,"location":"138 Wohlers Hall","instructors":["Abou Abdallah, M"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"This course explores the historical roots of major conflicts and wars, as well as the relationships between ancient civilizations—such as the Egyptians, Mesopotamians, and Phoenicians—and contemporary states. We will analyze data dating back to the end of the second millennium BC to enhance our understanding of the various geopolitical dimensions at play. The course will take a step back to examine and contextualize historical and current dynamics, presenting the perspectives of the different parties involved in these conflicts. Topics covered in the course include the role of religious minorities, proxy wars, the conflict between Arabs and Persians, the Israel-Palestine conflict, Arab-Israeli relations, and the influence of non-state actors such as Hamas and Hezbollah. We will also discuss the regional balance of power between Saudi Arabia and Iran, as well as the war that began on October 7, 2023, along with its regional consequences."},{"crn":"31333","code":"B","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"B","dateRange":"03/16/26-05/06/26","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M","W"],"start":600,"end":710,"location":"132 Davenport Hall","instructors":["Bosak-Schroeder, C"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"Wonders of the World - In this class you will study the Seven Wonders of the Ancient World: the Great Pyramid of Giza, Hanging Gardens of Babylon, Temple of Artemis at Ephesus, Statue of Zeus at Olympia, Mausoleum at Halicarnassus, Colossus of Rhodes, and the Lighthouse of Alexandria. You will learn how they were made, what they meant to the people who built them, and the ways they have influenced modern art and architecture. Field trips to architectural wonders on the UIUC campus will enrich our understanding of the past."},{"crn":"31332","code":"C","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":570,"end":650,"location":"156 English Building","instructors":["Garcia-Molina, E"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"The Ancient World in Video Games - How do you render the ancient world within video games? How do you play antiquity? This course explores the interrelated issues faced by game designers, historians, and archaeologists when attempting to recreate antiquity. From realizing myths and monsters to raising armies and battlefields to redefining the rise of urbanism and early states, historical and archaeological questions have influenced the design of games set in ancient Rome, Greece, Egypt, and Mesopotamia. We will survey a broad range of video games across time and genres with an eye towards their translation of ancient histories, literature, and material culture within their audio, visual, and mechanical designs. In doing so, we will get a better grasp at how historical and archeological issues affect game design and popular perceptions of antiquity; we will then design and workshop game concepts or virtual exhibits that take advantage of the unique position of video games and virtual reality as media with which to immerse audiences in the complex histories of antiquity."},{"crn":"63846","code":"CHP","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T","R"],"start":660,"end":740,"location":"301 Architecture Building","instructors":["Walters, B"]}],"restrictions":["Restricted to Chancellor's Scholar-CHPHonors students."],"coRequest":null,"specialApproval":null,"sectionText":"Nightmares of Nero - Few Roman emperors have been so constantly reviled in history and popular culture as Nero. Ancient sources depict him as a deviant, a larger-than-life monster, a tyrant, a megalomaniac, an arsonist, a murderer. Early Christians demonized him as their greatest persecutor, and apocalyptic prophecies identified him with the Antichrist. Setting its sights on the various myths and exaggerations that have come down to us about Nero, this course explores the question of what we can know of the infamous emperor and the age that bears his name. Particular emphasis will be placed on the nightmarish refractions of Neronian Rome found in the works of Seneca, Lucan, and Petronius."},{"crn":"45762","code":"G","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["M","W"],"start":900,"end":980,"location":"1128 Literatures, Cultures, & Ling","instructors":["Tzanetou, A"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"Thinking about Trauma through Athenian Drama - Ancient theater offered the space for reflecting upon the violence and trauma for its original audiences and for contemporary societies. This course focuses on the experiences of the ancients with war, trauma, and the plight of veterans, prisoners of war, and refugees. It also looks beyond Athenian theater to modern adaptations by theater companies, playwrights, directors and speaks to modern issues, making the plays respond to the ravages of contemporary wars, the experience of refugees, and gender violence: allowing them to speak directly to communities of color and issues of social justice. Readings include both ancient Greek plays and modern adaptations of select plays. This CLCV 220 will be co-taught by Paul O'Mahony, Director of Out-of-Chaos Theatre, London, UK and in the second half of the semester students will work with Paul O'Mahony, Kim McKean (Theater) and Angeliki Tzanetou (Classics) in writing and performing an adaptation of Aeschylus's Suppliants."}]},{"id":"CLCV 224","subject":"CLCV","number":"224","title":"Greco-Roman Antiquity and US Minority Cultures","creditHours":"3 hours","minHours":3,"genEd":["1LA","1US"],"degreeAttributes":"Humanities - Lit & Arts, and Cultural Studies - US Minority course.","scheduleNote":"","info":"","linkedByLetter":true,"sections":[{"crn":"70183","code":"AD1","typeCode":"DIS"