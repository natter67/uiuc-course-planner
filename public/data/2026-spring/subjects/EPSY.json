LCD","days":["F"],"start":540,"end":710,"location":"385 Education Building","instructors":["Kern, J"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":"Seminar Full Title: Introduction to R for Data Analysis and Computation"},{"crn":"34356","code":"E","typeCode":"PR","group":"pr","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Practice","typeCode":"PR","days":[],"start":null,"end":null,"location":"Location Pending","instructors":["Khuri, M"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"65696","code":"EPP","typeCode":"ONL","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Online","typeCode":"ONL","days":["T"],"start":780,"end":950,"location":"n.a.","instructors":["Stone, C"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null},{"crn":"46888","code":"ML","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["T"],"start":570,"end":740,"location":"37 Education Building","instructors":["Bosch, N"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"Causal inference is crucial in many scenarios, such as when offering interventions intended to improve education or when making policy decisions that are expected to cause certain changes. However, conducting a randomized controlled trial to answer every research question is often infeasible, or even unethical. This course will cover perspectives on causality and cutting-edge machine learning methods for causal inference in situations with non-linear effects, heterogeneous effects, large numbers of confounders, natural experiments, and even observational data. Students should have some previous stats experience (EPSY 580, IS 507, or similar, or approval of instructor). Students should also have familiarity with loading and manipulating datasets in R or Python."},{"crn":"34337","code":"QDA","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["R"],"start":780,"end":950,"location":"242 Armory","instructors":["Mitchell, N"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"coRequest":null,"specialApproval":null,"sectionText":"Title: \"Qualitative Data Analysis\" This course will have an in-person component on Thursdays as well as an asynchronous component."},{"crn":"62820","code":"QWR","typeCode":"ONL","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Online","typeCode":"ONL","days":["W"],"start":720,"end":1010,"location":"n.a.","instructors":["Goodnight, M"]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":"Meets with CI 552 A."},{"crn":"40618","code":"SPA","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["W"],"start":840,"end":1010,"location":"138 Wohlers Hall","instructors":["Camins, J"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign.","Restricted to MS:MentalHealthCounseling-UIUC."],"coRequest":null,"specialApproval":"Instructor Approval Required","sectionText":"Title: Survey of Psychological Assessment Methods. This course will meet in DRES Conference Room (107)."},{"crn":"34336","code":"TH","typeCode":"LCD","group":"lecture","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Lecture-Discussion","typeCode":"LCD","days":["R"],"start":780,"end":950,"location":"138 Wohlers Hall","instructors":["Beard, J"]}],"restrictions":["Restricted to Graduate - Urbana-Champaign."],"coRequest":null,"specialApproval":"Instructor Approval Required","sectionText":"This course is designed to prepare you to work with individuals attempting to recover from addictions. It will cover a broad range of topics, including foundational information related to addiction and the substances and processes that underlie it, models of assessment, theoretical approaches to treatment, and current professional issues."}]},{"id":"EPSY 591","subject":"EPSY","number":"591","title":"Field Study and Thesis Seminar","creditHours":"4 TO 8 hours","minHours":4,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Prerequisite: Limited to students who have been admitted for doctoral study.","linkedByLetter":false,"sections":[{"crn":"10380","code":"","typeCode":"IND","group":"ind","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Independent Study","typeCode":"IND","days":[],"start":null,"end":null,"location":"Location Pending","instructors":[]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]},{"id":"EPSY 595","subject":"EPSY","number":"595","title":"Independent Study","creditHours":"0 TO 4 hours","minHours":0,"genEd":[],"degreeAttributes":"","scheduleNote":"","info":"Approved for both letter and S/U grading. May be repeated with approval. Prerequisite: Approval of study outline by adviser and the department chairperson prior to enrollment.","linkedByLetter":false,"sections":[{"crn":"10050","code":"","typeCode":"IND","group":"ind","status":"unknown","statusText":"","partOfTerm":"1","dateRange":"","meetings":[{"typeName":"Independent Study","typeCode":"IND","days":[],"start":null,"end":null,"location":"Location Pending","instructors":[]}],"restrictions":[],"coRequest":null,"specialApproval":null,"sectionText":null}]}]