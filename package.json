{
  "name": "uiuc-course-planner",
  "version": "1.0.0",
  "description": "One planner for UIUC students: requirements, GPA, professors and conflict-free schedules.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "data:build": "tsx scripts/build-data.ts",
    "data:crawl": "tsx scripts/crawl.ts",
    "data:gpa": "mkdir -p data/raw && curl -sSL -o data/raw/uiuc-gpa-dataset.csv https://raw.githubusercontent.com/wadefagen/datasets/main/gpa/uiuc-gpa-dataset.csv",
    "data:sample": "tsx scripts/build-data.ts data/raw/2026-fall-sample.json",
    "ext:build": "esbuild extension/src/content.ts --bundle --format=iife --target=chrome110 --outfile=extension/content.js --legal-comments=none"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "fast-xml-parser": "^5.11.2",
    "next": "^15.5.27",
    "node-html-parser": "^9.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
